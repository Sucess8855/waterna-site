---
import { site } from '../data/site';
import { projectEngineering, plantPerformance, softwareProducts, serviceHref, hasPage } from '../data/services';
const year = new Date().getFullYear();

const accreditations = [
  { name: 'IChemE', file: 'icheme' },
  { name: 'CIWEM', file: 'ciwem' },
  { name: 'ADBA', file: 'adba' },
];

/** Plant Performance and Software share a column — both concern running plant. */
const performanceAndSoftware = [...plantPerformance, ...softwareProducts];
---

<footer class="ftr">
  <div class="wrap ftr__accred">
    <p class="ftr__accred-label">We are proudly Chartered member of</p>
    <ul class="ftr__logos">
      {
        accreditations.map((a) => (
          <li>
            <img
              src={`/img/accreditations/${a.file}.png`}
              alt={a.name}
              height="120"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <img src="/logo.png" alt={site.name} width="113" height="44" />
      <p class="ftr__tagline">Design for a Sustainable Future</p>
      <ul class="ftr__contact">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Project Engineering</h2>
      <ul>
        {projectEngineering.map((s) => <li>{hasPage(s) ? <a href={serviceHref(s)}>{s.navTitle ?? s.title}</a> : <span>{s.navTitle ?? s.title}</span>}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Plant Performance</h2>
      <ul>
        {performanceAndSoftware.map((s) => <li>{hasPage(s) ? <a href={serviceHref(s)}>{s.navTitle ?? s.title}</a> : <span>{s.navTitle ?? s.title}</span>}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Company</h2>
      <ul>
        <li><a href="/services">What we do</a></li>
        <li><a href="/sectors">Sectors</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="ftr__legal">
    <div class="wrap ftr__legal-inner">
      <p>
        {site.legalName} is a limited company registered in the United Kingdom, registration number {
          site.companyNumber
        }.
      </p>
      <p>&copy; {year} Waterna. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  /* Warm stone rather than another band of blue. It also gives the
     accreditation marks the light ground they were drawn for. */
  .ftr {
    background: #f0ede8;
    color: var(--body);
  }

  /* ---------- accreditations ---------- */

  .ftr__accred {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: 2.25rem;
    border-bottom: 1px solid #ddd8d1;
  }

  @media (min-width: 820px) {
    .ftr__accred {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
    }
  }

  .ftr__accred-label {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .ftr__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  .ftr__logos li {
    margin: 0;
  }

  .ftr__logos img {
    height: 42px;
    width: auto;
    /* The marks are drawn for white, so multiply blends them into the
       stone instead of leaving three visible white boxes. */
    mix-blend-mode: multiply;
  }

  /* ---------- columns ---------- */

  .ftr__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-block: 2.5rem;
  }

  @media (min-width: 700px) {
    .ftr__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .ftr__grid {
      grid-template-columns: 1.1fr 1fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .ftr__brand img {
    height: 44px;
    width: auto;
    margin-bottom: 0.75rem;
  }

  .ftr__tagline {
    font-size: 0.92rem;
    font-style: italic;
    color: var(--brand);
    margin-bottom: 1rem;
  }

  .ftr__h {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin: 0 0 0.9rem;
  }

  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ftr li {
    margin-bottom: 0.45rem;
  }

  .ftr a {
    color: var(--body);
    text-decoration: none;
    font-size: 0.93rem;
  }

  .ftr a:hover {
    color: var(--brand-deep);
    text-decoration: underline;
  }

  .ftr__contact a {
    font-weight: 600;
  }

  /* ---------- legal ---------- */

  .ftr__legal {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    padding-block: 1.1rem;
  }

  .ftr__legal-inner {
    display: grid;
    gap: 0.3rem;
  }

  @media (min-width: 760px) {
    .ftr__legal-inner {
      grid-template-columns: 1fr auto;
      gap: 2rem;
    }
  }

  .ftr__legal p {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
