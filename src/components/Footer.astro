---
import { site } from '../data/site';
import { projectEngineering, plantPerformance, softwareProducts, serviceHref } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <p class="ftr__brand">{site.name}</p>
      <p class="ftr__small">{site.tagline}</p>
      <p class="ftr__small">
        {site.address.street}<br />
        {site.address.city} {site.address.postcode}<br />
        {site.address.country}
      </p>
    </div>

    <div>
      <h2 class="ftr__h">Project Engineering</h2>
      <ul>
        {projectEngineering.map((s) => <li><a href={serviceHref(s)}>{s.navTitle ?? s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Plant Performance</h2>
      <ul>
        {plantPerformance.map((s) => <li><a href={serviceHref(s)}>{s.navTitle ?? s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Software</h2>
      <ul>
        {softwareProducts.map((s) => <li><a href={serviceHref(s)}>{s.navTitle ?? s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Company</h2>
      <ul>
        <li><a href="/services">What we do</a></li>
        <li><a href="/sectors">Sectors</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>

    <div>
      <h2 class="ftr__h">Get in touch</h2>
      <ul>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr__legal">
    <p>
      &copy; {year} {site.legalName}. Registered in England &amp; Wales, company no. {site.companyNumber}.
    </p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--brand-deep);
    color: #cdd7ea;
    padding-top: 3.5rem;
    margin-top: 0;
  }

  .ftr__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 700px) {
    .ftr__grid {
      grid-template-columns: 1.2fr 1fr 1fr 0.8fr 0.9fr 1fr;
    }
  }

  .ftr__brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .ftr__h {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #fff;
    margin: 0 0 0.85rem;
  }

  .ftr__small {
    font-size: 0.92rem;
    margin-bottom: 0.9rem;
  }

  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ftr li {
    margin-bottom: 0.45rem;
  }

  .ftr a {
    color: #cdd7ea;
    text-decoration: none;
    font-size: 0.94rem;
  }

  .ftr a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .ftr__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: 1.25rem;
  }

  .ftr__legal p {
    margin: 0;
    font-size: 0.85rem;
    color: #a9b6d0;
  }
</style>
