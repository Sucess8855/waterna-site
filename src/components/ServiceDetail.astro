---
import { site } from '../data/site';
import { DEFAULT_HEADINGS, relatedTo, serviceHref, type Service } from '../data/services';
import { pillarBySlug } from '../data/pillars';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const headings = service.headings ?? DEFAULT_HEADINGS;
const related = relatedTo(service);
const pillar = pillarBySlug(service.pillar);
const isProduct = service.kind === 'product';
---

<section class="phead">
  <div class="wrap">
    {isProduct && <p class="ptag">Software platform</p>}
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`/${service.pillar}`}>{pillar?.title}</a> <span aria-hidden="true">&rsaquo;</span>
      <span>{service.navTitle ?? service.title}</span>
    </nav>
    <h1>{service.title}</h1>
    <p class="lede">{service.intro}</p>
  </div>
</section>

<section class="section">
  <div class="wrap cols">
    <div class="cols__main">
      <h2>{headings.why}</h2>
      {service.why.map((para) => <p>{para}</p>)}

      <h2>{headings.covered}</h2>
      <dl class="deflist">
        {
          service.covered.map(([term, def]) => (
            <div>
              <dt>{term}</dt>
              <dd>{def}</dd>
            </div>
          ))
        }
      </dl>

      <h2>{headings.deliverables}</h2>
      <p>{service.deliverables}</p>
    </div>

    <aside class="cols__side">
      <div class="panel">
        <h2 class="panel__h">{isProduct ? 'See it on your data' : 'Talk it through'}</h2>
        <p>
          {
            isProduct
              ? 'The quickest way to judge it is against a sample of your own plant data. Tell us what you record and we will show you what it produces.'
              : 'Most work starts with a short conversation about your water, your flows and the consent you are working to.'
          }
        </p>
        <p class="panel__contact">
          <a class="btn btn--primary" href={site.phoneHref}>Call {site.phone}</a>
        </p>
        <p class="panel__small">
          Or email <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      {
        related.length > 0 && (
          <div class="panel panel--plain">
            <h2 class="panel__h">Related</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={serviceHref(r)}>{r.navTitle ?? r.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</section>

<style>
  .phead {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .ptag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--brand-deep);
    border-radius: 3px;
    padding: 0.25rem 0.6rem;
    margin: 0 0 0.9rem;
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .crumbs a {
    color: var(--brand);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .crumbs span[aria-hidden] {
    margin-inline: 0.35rem;
  }

  .cols {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 3.5rem;
      align-items: start;
    }

    .cols__side {
      position: sticky;
      top: 6rem;
    }
  }

  .cols__main h2 {
    margin-top: 2.25rem;
  }

  .cols__main h2:first-child {
    margin-top: 0;
  }

  .cols__main p {
    max-width: 68ch;
  }

  .deflist {
    margin: 0 0 1.5rem;
  }

  .deflist > div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .deflist dt {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }

  .deflist dd {
    margin: 0;
    font-size: 0.98rem;
    max-width: 68ch;
  }

  .panel {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .panel--plain {
    background: #fff;
  }

  .panel__h {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .panel p {
    font-size: 0.95rem;
  }

  .panel__contact {
    margin-bottom: 0.6rem;
  }

  .panel__small {
    margin-bottom: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .panel li {
    margin-bottom: 0.4rem;
  }

  .panel li a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .panel li a:hover {
    text-decoration: underline;
  }
</style>
