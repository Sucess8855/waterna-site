---
// The landing page for a service pillar: split hero, an intro with a
// "when we can help" panel, the list of services, and a closing call band.
import { site } from '../data/site';
import { hasPage, serviceHref, type Service } from '../data/services';

interface ExtraRow {
  title: string;
  desc: string;
  href: string;
  label: string;
  icon: string;
}

interface Props {
  eyebrow: string;
  title: string;
  /** Each entry sits on its own line on wide screens. */
  sub: string[];
  lede: string;
  heroCta: string;
  image: { base: string; alt: string };
  introTitle: string;
  intro: string[];
  helpWith: string[];
  servicesTitle: string;
  services: Service[];
  /** One-line descriptions, keyed by service slug. */
  lines: Record<string, string>;
  /** SVG path markup, keyed by service slug. */
  icons: Record<string, string>;
  extra?: ExtraRow;
  ctaTitle: string;
  ctaText: string;
}

const {
  eyebrow, title, sub, lede, heroCta, image, introTitle, intro, helpWith,
  servicesTitle, services, lines, icons, extra, ctaTitle, ctaText,
} = Astro.props;
---

<section class="pl-hero">
  <div class="wrap pl-hero__grid">
    <div class="pl-hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="pl-hero__sub">{sub.map((line) => <span>{line}</span>)}</p>
      <p class="pl-hero__lede">{lede}</p>
      <a class="btn btn--primary btn--arrow" href="/contact">
        {heroCta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
    <picture class="pl-hero__media">
      <source
        type="image/webp"
        srcset={`/img/pillars/${image.base}-800.webp 800w, /img/pillars/${image.base}-1400.webp 1400w`}
        sizes="(min-width: 960px) 45vw, 100vw"
      />
      <img
        src={`/img/pillars/${image.base}-1400.jpg`}
        alt={image.alt}
        width="1400"
        height="1050"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>

<section class="pl-intro">
  <div class="wrap pl-intro__grid">
    <div>
      <h2>{introTitle}</h2>
      {intro.map((p) => <p>{p}</p>)}
    </div>
    <aside class="pl-help">
      <h3>When we can help</h3>
      <ul>
        {
          helpWith.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="11" />
                <path d="m7.5 12.5 3 3 6-6.5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<section class="pl-services">
  <div class="wrap">
    <h2>{servicesTitle}</h2>
    <ul class="pl-list">
      {
        services.map((s) => (
          <li>
            {hasPage(s) ? (
              <a class="pl-list__row pl-list__row--link" href={serviceHref(s)}>
                <svg class="pl-list__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.slug] ?? ''} />
                <span class="pl-list__text">
                  <span class="pl-list__title">{s.title}</span>
                  <span class="pl-list__desc">{lines[s.slug] ?? s.summary}</span>
                </span>
                <svg class="pl-list__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            ) : (
              <div class="pl-list__row">
                <svg class="pl-list__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.slug] ?? ''} />
                <span class="pl-list__text">
                  <span class="pl-list__title">{s.title}</span>
                  <span class="pl-list__desc">{lines[s.slug] ?? s.summary}</span>
                </span>
              </div>
            )}
          </li>
        ))
      }
      {
        extra && (
          <li>
            <a class="pl-list__row pl-list__row--link" href={extra.href}>
              <svg class="pl-list__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={extra.icon} />
              <span class="pl-list__text">
                <span class="pl-list__title">{extra.title}</span>
                <span class="pl-list__desc">{extra.desc}</span>
              </span>
              <span class="pl-list__more">
                <span class="pl-list__more-label">{extra.label}</span>
                <svg class="pl-list__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </a>
          </li>
        )
      }
    </ul>
  </div>
</section>

<section class="pl-cta">
  <div class="wrap">
    <h2>{ctaTitle}</h2>
    <p>{ctaText}</p>
    <div class="pl-cta__actions">
      <a class="btn btn--light btn--arrow" href="/contact">
        Contact us
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
      <span class="pl-cta__rule" aria-hidden="true"></span>
      <a class="pl-cta__phone" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
        {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- hero ---------- */

  /* Same contained split as the sector pages, so the photo keeps a fixed
     shape instead of growing with the window. */
  .pl-hero {
    background: #eaf2fa;
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .pl-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .pl-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .pl-hero h1 {
    color: var(--brand-deep);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .pl-hero__sub span {
    display: block;
  }

  .pl-hero__sub {
    color: var(--brand-deep);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .pl-hero__lede {
    font-size: 1.1rem;
    max-width: 44ch;
    margin-bottom: 1.8rem;
  }

  .pl-hero__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: var(--shadow-card);
  }

  .btn--arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn--arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn--arrow:hover svg {
    transform: translateX(3px);
  }

  /* ---------- intro ---------- */

  .pl-intro {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pl-intro__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .pl-intro__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }

  .pl-intro h2 {
    color: var(--brand-deep);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    max-width: 18ch;
    margin-bottom: 1.2rem;
  }

  .pl-intro p {
    max-width: 52ch;
  }

  .pl-help {
    background: #eaf2fa;
    border-radius: 4px;
    padding: 2rem 2.2rem;
  }

  .pl-help h3 {
    color: var(--brand-deep);
    font-size: 1.4rem;
    margin-bottom: 1.1rem;
  }

  .pl-help ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pl-help li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.9rem;
    color: var(--ink);
  }

  .pl-help li:last-child {
    margin-bottom: 0;
  }

  .pl-help svg {
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
  }

  .pl-help svg circle {
    fill: #1a9fe0;
  }

  .pl-help svg path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- services ---------- */

  .pl-services {
    background: #eaf2fa;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pl-services h2 {
    color: var(--brand-deep);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 1.6rem;
  }

  .pl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .pl-list li {
    margin: 0;
  }

  .pl-list__row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.6rem;
    background: #fff;
    border: 1px solid #dfe8f1;
    border-radius: 4px;
    padding: 1.25rem 1.6rem;
    text-decoration: none;
    color: inherit;
  }

  .pl-list__row--link {
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pl-list__row--link:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -16px rgba(0, 63, 118, 0.35);
  }

  .pl-list__icon {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--brand-deep);
  }

  .pl-list__text {
    display: block;
  }

  .pl-list__title {
    display: block;
    color: var(--brand-deep);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 0.15rem;
  }

  .pl-list__desc {
    display: block;
    color: var(--body);
    font-size: 0.98rem;
  }

  .pl-list__arrow {
    width: 1.5rem;
    height: 1.5rem;
    color: #1a9fe0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pl-list__row--link:hover .pl-list__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 560px) {
    .pl-list__row {
      grid-template-columns: 2.2rem minmax(0, 1fr) auto;
      gap: 1rem;
      padding: 1rem 1.1rem;
    }

    .pl-list__icon {
      width: 2.1rem;
      height: 2.1rem;
    }
  }

  /* A row that points somewhere other than a service page — the label
     says where. #0A78C2 is 4.69:1 on white; the brighter arrow cyan is
     only 2.97:1, too low for text. */
  .pl-list__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #0a78c2;
    font-weight: 700;
    white-space: nowrap;
  }

  .pl-list__more .pl-list__arrow {
    color: currentColor;
  }

  @media (max-width: 560px) {
    .pl-list__more-label {
      display: none;
    }
  }

  /* ---------- cta ---------- */

  .pl-cta {
    background: var(--brand-deep);
    color: rgba(255, 255, 255, 0.9);
    padding-block: clamp(2.5rem, 5vw, 3.25rem);
  }

  .pl-cta h2 {
    color: #fff;
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 800;
    margin-bottom: 0.6rem;
  }

  .pl-cta p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .pl-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .pl-cta__rule {
    width: 1px;
    height: 2.4rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .pl-cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pl-cta__phone:hover {
    text-decoration: underline;
  }

  .pl-cta__phone svg {
    width: 1.4rem;
    height: 1.4rem;
  }
</style>
