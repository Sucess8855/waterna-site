---
import Base from '../../layouts/Base.astro';
import PillarLanding from '../../components/PillarLanding.astro';
import { roInsight, serviceHref } from '../../data/services';
import { softwarePillar } from '../../data/pillars';

const roHref = serviceHref(roInsight);

const helpWith = [
  'Reduce repetitive manual analysis',
  'Track changes against a baseline',
  'Compare train performance',
  'Support timely operating decisions',
];

const features = [
  {
    title: 'Membrane health',
    text: 'Review performance, fouling and scaling risks.',
    icon: '<path d="M4 20h16"/><rect x="5" y="13" width="3" height="7"/><rect x="10.5" y="8" width="3" height="12"/><rect x="16" y="3" width="3" height="17"/>',
  },
  {
    title: 'Cleaning decisions',
    text: 'Assess cleaning effectiveness and plan ahead.',
    icon: '<path d="M10 2v7.31"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/>',
  },
  {
    title: 'Operating efficiency',
    text: 'Compare trains and investigate energy use.',
    icon: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  },
];

const dataPoints = [
  {
    title: 'Data inputs',
    text: 'Use plant records or configured live connections.',
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  },
  {
    title: 'Deployment',
    text: 'Review data availability and infrastructure requirements.',
    icon: '<rect x="3" y="3" width="18" height="5" rx="1.5"/><rect x="3" y="9.5" width="18" height="5" rx="1.5"/><rect x="3" y="16" width="18" height="5" rx="1.5"/><path d="M6.5 5.5h.01M6.5 12h.01M6.5 18.5h.01"/>',
  },
  {
    title: 'Engineering support',
    text: 'Combine software with specialist performance reviews.',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';
---

<Base title={softwarePillar.metaTitle} description={softwarePillar.metaDescription}>
  <PillarLanding
    eyebrow="Engineering insight. Informed decisions."
    title="Analytics Software"
    sub={['Make more of your operating data.']}
    lede="Software built around process engineering to help teams assess performance, recognise developing problems and make informed operating decisions."
    heroCta="Explore RO Insight™"
    heroHref={roHref}
    image={{ base: 'as-hero', alt: 'An engineer reviewing performance trends on a desktop monitor' }}
    introTitle="Engineering methods, applied consistently"
    intro={[
      'Bring recurring calculations, trends and diagnostic checks into one place. Software supports day-to-day review and complements specialist engineering assessments.',
    ]}
    helpWith={helpWith}
    helpTitle="When software can help"
    ctaTitle="Discuss your software requirements"
    ctaText="Tell us about your plant, available data and monitoring objectives."
    ctaTone="light"
  >
    <section class="as-ro">
      <div class="wrap as-ro__inner">
        <div class="as-ro__grid">
          <div>
            <p class="as-ro__eyebrow">Our software</p>
            <h2>Waterna RO Insight™</h2>
            <p class="as-ro__sub">
              Performance monitoring and decision support for reverse osmosis desalination.
            </p>

            <ul class="as-ro__stats">
              <li><strong>100+</strong> engineering indicators</li>
              <li><strong>Offline</strong> AI assistant</li>
            </ul>

            <a class="btn btn--light as-btn" href={roHref}>
              Explore RO Insight™ <Fragment set:html={arrow} />
            </a>
          </div>

          <!-- The same real screens as the homepage RO Insight section. -->
          <figure class="as-ro__visual">
            <div class="as-ro__frame">
              <div class="as-ro__bar" aria-hidden="true"><span></span><span></span><span></span></div>
              <picture>
                <source
                  type="image/webp"
                  srcset="/img/ro-insight/dash-full-900.webp 900w, /img/ro-insight/dash-full-1400.webp 1400w"
                  sizes="(min-width: 960px) 55vw, 100vw"
                />
                <img
                  src="/img/ro-insight/dash-full-1400.jpg"
                  alt="RO Insight live dashboard: plant status, fleet KPI snapshot and diagnostic overview"
                  width="1400"
                  height="795"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>

            <div class="as-ro__card">
              <p class="as-ro__card-head">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>
                Offline AI assistant
              </p>
              <picture>
                <source type="image/webp" srcset="/img/ro-insight/assistant-card.webp" />
                <img
                  src="/img/ro-insight/assistant-card.png"
                  alt="The offline assistant answering: give me a concise summary of the current plant status"
                  width="560"
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>

            <figcaption>Real screens: the RO Live Dashboard and the offline AI assistant</figcaption>
          </figure>
        </div>

        <ul class="as-ro__features">
          {
            features.map((f) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
                <div>
                  <h3>{f.title}</h3>
                  <p>{f.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="as-data">
      <div class="wrap">
        <h2>Built around your data</h2>
        <ul class="as-data__list">
          {
            dataPoints.map((d) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d.icon} />
                <div>
                  <h3>{d.title}</h3>
                  <p>{d.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </PillarLanding>
</Base>

<style>
  /* ---------- RO Insight band ---------- */

  .as-ro {
    position: relative;
    overflow: hidden;
    background: var(--brand-deep);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .as-ro__inner {
    position: relative;
  }

  .as-ro__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  @media (min-width: 960px) {
    .as-ro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* ---- the tilted screen, as on the homepage ---- */

  .as-ro__visual {
    position: relative;
    margin: 0;
  }

  .as-ro__frame {
    background: #0a0e19;
    border: 1px solid rgba(0, 185, 245, 0.35);
    border-radius: 12px;
    padding: 0 0.7rem 0.7rem;
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.65),
      0 0 70px -10px rgba(0, 185, 245, 0.3);
  }

  .as-ro__bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.2rem;
  }

  .as-ro__bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #33415a;
  }

  .as-ro__bar span:first-child {
    background: #e0564f;
  }

  .as-ro__frame img,
  .as-ro__card img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .as-ro__card {
    background: #0b1426;
    border: 1px solid rgba(0, 185, 245, 0.55);
    border-radius: 10px;
    padding: 0.8rem 0.8rem 0.9rem;
    margin-top: 1rem;
    box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.7), 0 0 40px -12px rgba(0, 185, 245, 0.45);
  }

  .as-ro__card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .as-ro__card-head svg {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
  }

  .as-ro__visual figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (min-width: 960px) {
    /* The tilt enlarges the near edge, so the screen is pulled in from the
       column edge to keep its frame inside the viewport. */
    .as-ro__visual {
      margin-right: 2.5rem;
    }

    .as-ro__frame {
      transform: perspective(1600px) rotateY(-17deg) rotateX(4deg);
      transform-origin: left center;
    }

    .as-ro__card {
      position: absolute;
      right: -2.25rem;
      bottom: 2.2rem;
      width: 46%;
      margin: 0;
    }

    .as-ro__visual figcaption {
      margin-top: 1.6rem;
    }
  }

  /* Rust drops to 2.3:1 on navy; cyan holds 4.7:1. */
  .as-ro__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .as-ro h2 {
    color: #fff;
    font-size: clamp(2.1rem, 3.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .as-ro__sub {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: #d6e6f5;
    max-width: 36ch;
    margin-bottom: 1.6rem;
  }

  .as-ro__stats {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem 1.5rem;
  }

  .as-ro__stats li {
    margin: 0;
    color: #d6e6f5;
    font-size: 1.05rem;
  }

  .as-ro__stats li + li {
    padding-left: 1.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }

  .as-ro__stats strong {
    color: #fff;
    font-size: clamp(1.5rem, 2.2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-right: 0.35rem;
  }

  .as-ro__features,
  .as-data__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.8rem;
  }

  @media (min-width: 820px) {
    .as-ro__features,
    .as-data__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .as-ro__features li,
    .as-data__list li {
      padding-inline: 2rem;
    }

    .as-ro__features li:first-child,
    .as-data__list li:first-child {
      padding-left: 0;
    }

    .as-ro__features li + li {
      border-left: 1px solid rgba(255, 255, 255, 0.22);
    }

    .as-data__list li + li {
      border-left: 1px solid var(--line);
    }
  }

  .as-ro__features li,
  .as-data__list li {
    margin: 0;
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .as-ro__features svg,
  .as-data__list svg {
    width: 2.8rem;
    height: 2.8rem;
    flex: none;
  }

  .as-ro__features svg {
    color: #fff;
  }

  .as-ro__features h3 {
    color: #fff;
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .as-ro__features p {
    color: #c4daee;
    font-size: 0.98rem;
    margin: 0;
  }

  .as-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .as-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .as-btn:hover :global(svg) {
    transform: translateX(3px);
  }

  /* ---------- built around your data ---------- */

  .as-data {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .as-data h2 {
    color: var(--brand-deep);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 1.8rem;
  }

  .as-data__list svg {
    color: var(--brand-deep);
  }

  .as-data__list h3 {
    color: var(--brand-deep);
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .as-data__list p {
    font-size: 0.98rem;
    margin: 0;
  }
</style>
