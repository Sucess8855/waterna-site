---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base
  title="Thank you | Waterna"
  description="Your enquiry has been sent to Waterna. We normally reply within one working day."
>
  <section class="ty">
    <div class="wrap ty__inner">
      <p class="eyebrow">Enquiry sent</p>
      <h1>Thank you — we have your message</h1>
      <p class="lede">
        We normally reply within one working day. If it is urgent, calling is faster than waiting for
        an email.
      </p>
      <div class="ty__actions">
        <a class="btn btn--primary" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn btn--ghost" href="/services">Browse our services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ty {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--line);
  }

  .ty__inner {
    padding-block: clamp(4rem, 12vw, 8rem);
    max-width: 46rem;
  }

  .ty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
