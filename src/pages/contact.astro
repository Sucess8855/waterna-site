---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Contact Waterna | Water Treatment Consultants"
  description="Talk to an independent water and wastewater treatment engineer. Call +44 7450 201927, email info@waterna.co.uk, or send an enquiry."
>
  <section class="phead">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Talk to an engineer</h1>
      <p class="lede">
        You will speak to someone who does the work, not a sales desk. The first conversation costs
        nothing, and if the answer is that you do not need us, we will say so.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div class="cols__main">
        <h2>Send an enquiry</h2>
        <p class="form__intro">
          If you would rather write than call, this reaches the same people. Everything except your
          message is there so we can reply properly.
        </p>

        <form class="form" method="POST" action="/api/contact">
          <div class="form__row">
            <div class="field">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" autocomplete="organization" />
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">Phone <span class="opt">(optional)</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <div class="field">
            <label for="subject">What is this about?</label>
            <select id="subject" name="subject">
              <option value="feasibility">A new scheme — feasibility or design</option>
              <option value="problem">An existing plant that is not performing</option>
              <option value="review">A second opinion on someone else's design</option>
              <option value="hazop">A HAZOP or risk study</option>
              <option value="training">Training</option>
              <option value="other">Something else</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Your message</label>
            <textarea id="message" name="message" rows="7" required></textarea>
            <p class="hint">
              Useful if you have it: the flow, what is in the water, and the consent or specification
              you are working to.
            </p>
          </div>

          <!-- Honeypot: real people leave this empty. -->
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button class="btn btn--primary" type="submit">Send enquiry</button>
          <p class="hint">
            We use what you send only to answer your enquiry. See our{' '}
            <a href="/privacy">privacy policy</a>.
          </p>
        </form>
      </div>

      <aside class="cols__side">
        <div class="panel">
          <h2 class="panel__h">Direct</h2>
          <p class="direct">
            <a class="direct__phone" href={site.phoneHref}>{site.phone}</a>
            <span class="direct__note">Fastest way to reach us</span>
          </p>
          <p class="direct">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p class="direct">
            <a href={site.linkedin} rel="noopener">LinkedIn</a>
          </p>
        </div>

        <div class="panel panel--plain">
          <h2 class="panel__h">Registered office</h2>
          <address>
            {site.legalName}<br />
            {site.address.street}<br />
            {site.address.city}<br />
            {site.address.postcode}<br />
            {site.address.country}
          </address>
          <p class="panel__small">
            Registered in England &amp; Wales, company no. {site.companyNumber}.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .phead {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .cols {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 3.5rem;
      align-items: start;
    }

    .cols__side {
      position: sticky;
      top: 6rem;
    }
  }

  .cols__main h2 {
    margin-top: 0;
  }

  .form__intro {
    max-width: 62ch;
  }

  .form {
    max-width: 42rem;
    margin-top: 1.5rem;
  }

  .form__row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 620px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    margin-bottom: 1rem;
  }

  .field label {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .opt {
    font-weight: 400;
    color: var(--muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.65rem 0.75rem;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--brand);
  }

  .hint {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0.45rem 0 0;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form button {
    margin-top: 0.5rem;
    cursor: pointer;
  }

  .panel {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .panel--plain {
    background: #fff;
  }

  .panel__h {
    font-size: 1.05rem;
    margin-bottom: 0.8rem;
  }

  .direct {
    margin-bottom: 0.9rem;
  }

  .direct:last-child {
    margin-bottom: 0;
  }

  .direct__phone {
    display: block;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }

  .direct__note {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }

  address {
    font-style: normal;
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
  }

  .panel__small {
    margin-bottom: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
