---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projectEngineering, plantPerformance, softwareProducts, serviceHref, hasPage } from '../data/services';
import { pillars, softwarePillar } from '../data/pillars';
import { sectors } from '../data/sectors';

---

<Base
  title="Water Treatment Consultants | UF &amp; RO Desalination | Waterna"
  description="Independent UK water and wastewater consultancy with specialist expertise in ultrafiltration and RO desalination. Feasibility, process design, HAZOP, plant optimisation and RO Insight software."
>
  <section class="hero">
    <picture>
      <source
        type="image/webp"
        srcset="/img/hero-clarifier-dusk-1200.webp 1200w, /img/hero-clarifier-dusk-1600.webp 1600w, /img/hero-clarifier-dusk-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/hero-clarifier-dusk-1600.jpg"
        alt="A wastewater clarifier bridge at dusk, its walkway reflected in still water"
        width="2000"
        height="917"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__scrim"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Independent water and wastewater consultancy</p>
      <h1 class="hero__title">Water treatment expertise</h1>
      <div class="hero__copy">
        <p>
          We help clients design, operate and improve water, wastewater and sludge treatment systems,
          with specialist expertise in ultrafiltration&nbsp;(UF) and reverse osmosis&nbsp;(RO)
          desalination.
        </p>
        <p>
          Drawing on more than 20 years of process engineering experience, we combine technical
          expertise with practical operational insight to improve plant performance, guide investment
          decisions and reduce whole-life costs.
        </p>
      </div>
      <a class="btn btn--primary hero__cta" href="/contact">Discuss your project</a>
      <p class="hero__note">
        Call <a href={site.phoneHref}>{site.phone}</a> or email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a> for a no-obligation initial discussion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>From project development to <span class="hl">plant performance and beyond</span></h2>
      <p class="lede">
        Whether you are developing a new treatment scheme or improving an existing plant, we provide
        engineering support to help you assess options, resolve problems and make informed decisions.
      </p>

      <div class="fork">
        {
          [...pillars, softwarePillar].map((p) => {
            const members =
              p.slug === 'project-engineering'
                ? projectEngineering
                : p.slug === 'plant-performance'
                  ? plantPerformance
                  : softwareProducts;
            return (
              <article class="fork__card card--lift">
                {
                  p.image && (
                    <a class="fork__media" href={`/${p.slug}`} tabindex="-1" aria-hidden="true">
                      <picture>
                        <source
                          type="image/webp"
                          srcset={`/img/pillars/${p.image}-600.webp 600w, /img/pillars/${p.image}-1200.webp 1200w`}
                          sizes="(min-width: 820px) 46vw, 100vw"
                        />
                        <img
                          src={`/img/pillars/${p.image}-1200.jpg`}
                          alt=""
                          width="1200"
                          height="462"
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </a>
                  )
                }
                <div class="fork__body">
                <p class="fork__strap">{p.strapline}</p>
                <h3>
                  <a href={`/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="fork__summary">{p.summary}</p>
                <ul class="fork__list">
                  {members.map((s) => (
                    <li>
                      {hasPage(s) ? (
                        <a href={serviceHref(s)}>{s.navTitle ?? s.title}</a>
                      ) : (
                        <span>{s.navTitle ?? s.title}</span>
                      )}
                    </li>
                  ))}
                </ul>
                <a class="btn btn--ghost" href={`/${p.slug}`}>
                  Explore {p.title}
                </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sectors</p>
      <h2>Expertise across water, wastewater and <span class="hl">sludge treatment</span></h2>

      <div class="grid grid--2 secgrid">
        {
          sectors.map((s) => (
            <article class="seccard card--lift">
              <a class="seccard__media" href={`/sectors/${s.slug}`} tabindex="-1" aria-hidden="true">
                <picture>
                  <source
                    type="image/webp"
                    srcset={`/img/sectors/${s.image}-600.webp 600w, /img/sectors/${s.image}-1200.webp 1200w`}
                    sizes="(min-width: 820px) 46vw, 100vw"
                  />
                  <img
                    src={`/img/sectors/${s.image}-1200.jpg`}
                    alt=""
                    width="1200"
                    height="674"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="seccard__body">
                <h3>{s.title}</h3>
                <p>{s.summary}</p>
                {
                  s.slug === 'uf-ro-desalination' && (
                    <p class="seccard__extra">
                      For RO plants, Waterna RO Insight™ adds ongoing performance monitoring and
                      diagnostics to support cleaning decisions, energy optimisation and membrane
                      management.
                    </p>
                  )
                }
                <p class="seccard__links">
                  <a href={`/sectors/${s.slug}`}>Explore {s.navTitle ?? s.title}</a>
                  {
                    s.slug === 'uf-ro-desalination' && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <a href="/ro-insight">Discover RO Insight™</a>
                      </>
                    )
                  }
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ro">
    <div class="wrap ro__wrap">
      <div class="ro__grid">
        <div class="ro__copy">
          <p class="ro__eyebrow">Analytics Software</p>
          <p class="ro__product">Waterna <span>RO Insight™</span></p>
          <h2 class="ro__title"><span>Understand performance.</span> <span>Plan your next move.</span></h2>
          <p class="ro__lede">
            Turn plant data into practical insights for membrane health, cleaning decisions and
            energy efficiency.
          </p>
          <ul class="ro__chips">
            <li><svg class="ro__chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>100+ KPIs</li>
            <li><svg class="ro__chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>Performance benchmarking</li>
            <li><svg class="ro__chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>Offline AI</li>
            <li><svg class="ro__chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>Machine learning</li>
          </ul>
          <a class="btn btn--light ro__btn" href="/ro-insight">
            Explore RO Insight™ <svg class="ro__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <figure class="ro__visual">
          <div class="ro__frame">
            <div class="ro__bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <picture>
              <source
                type="image/webp"
                srcset="/img/ro-insight/dash-full-900.webp 900w, /img/ro-insight/dash-full-1400.webp 1400w"
                sizes="(min-width: 900px) 58vw, 100vw"
              />
              <img
                src="/img/ro-insight/dash-full-1400.jpg"
                alt="RO Insight live dashboard: plant status, fleet KPI snapshot and diagnostic overview"
                width="1400"
                height="795"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>

          <div class="ro__card">
            <p class="ro__card-head"><svg class="ro__card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>Offline AI assistant</p>
            <picture>
              <source type="image/webp" srcset="/img/ro-insight/assistant-card.webp" />
              <img
                src="/img/ro-insight/assistant-card.png"
                alt="The offline assistant answering: give me a concise summary of the current plant status"
                width="560"
                height="300"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>

          <figcaption>Real screens: the RO Live Dashboard and the offline AI assistant</figcaption>
        </figure>
      </div>

      <ul class="ro__features">
        <li>
          <svg class="ro__feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          <div><h3>Membrane health</h3><p>Monitor performance, fouling and scaling.</p></div>
        </li>
        <li>
          <svg class="ro__feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
          <div><h3>Cleaning decisions</h3><p>Assess cleaning effectiveness and plan ahead.</p></div>
        </li>
        <li>
          <svg class="ro__feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          <div><h3>Operating efficiency</h3><p>Compare trains and identify energy opportunities.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="why">
    <div class="wrap">
      <p class="why__eyebrow">Why Waterna</p>
      <h2 class="why__title">Independent advice. <span>Practical engineering.</span></h2>
      <p class="why__lede">Clear recommendations, grounded in your plant’s needs.</p>

      <div class="why__grid">
        <article class="why__card">
          <svg class="why__icon" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g stroke="var(--brand-deep)"><circle cx="12" cy="12" r="10"/><path d="M12 2.8v1.4M12 19.8v1.4M2.8 12h1.4M19.8 12h1.4"/></g><g stroke="#1789cc"></g><polygon points="16.2 7.8 13.4 13.4 7.8 16.2 10.6 10.6" fill="#1789cc" stroke="#1789cc" stroke-width="1"/><circle cx="12" cy="12" r="1.1" fill="#fff" stroke="none"/></svg>
          <h3>Independent advice</h3>
          <p>
            No vendor agreements or supplier commissions. Recommendations based on your process
            requirements and operating goals.
          </p>
          <p>Our software is optional and available separately.</p>
        </article>
        <article class="why__card">
          <svg class="why__icon" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g stroke="var(--brand-deep)"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></g><g stroke="#1789cc"><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></g></svg>
          <h3>Whole-life value</h3>
          <p>
            Assess capital and operating costs together — including energy, chemicals, maintenance and
            replacement — to compare the true cost of each option.
          </p>
        </article>
        <article class="why__card">
          <svg class="why__icon" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g stroke="var(--brand-deep)"><path d="M13 21H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8l5 5v5"/><path d="M14 2v5h5"/><path d="M8 9h3M8 13h7M8 17h3"/></g><g stroke="#1789cc"><circle cx="17.5" cy="17.5" r="4.5" fill="#fff"/><path d="m15.6 17.6 1.4 1.4 2.6-2.8"/></g></svg>
          <h3>Compliance from the outset</h3>
          <p>
            Consider discharge limits, water quality specifications and permitting requirements early
            in process assessment and design.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="photoband">
    <picture>
      <source
        type="image/webp"
        srcset="/img/band-plant-1200.webp 1200w, /img/band-plant-1600.webp 1600w, /img/band-plant-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/band-plant-1600.jpg"
        alt="Pump hall inside a water treatment plant"
        width="2000"
        height="917"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="photoband__scrim"></div>
    <div class="wrap photoband__inner">
      <h2>Discuss your project with an <span class="hl hl--light">engineer</span></h2>
      <p>
        Speak directly with a process engineer about your treatment requirements, operating
        challenges or planned investment. We will help clarify the problem, identify the information
        needed and agree a practical next step.
      </p>
      <a class="btn btn--light" href="/contact">Contact us</a>
    </div>
  </section>

</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(30rem, 68vh, 45rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero picture,
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero img {
    object-fit: cover;
    object-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(0, 22, 44, 0.92) 0%,
      rgba(0, 22, 44, 0.86) 50%,
      rgba(0, 22, 44, 0.66) 78%,
      rgba(0, 22, 44, 0.3) 100%
    );
  }

  .hero__inner {
    padding-block: clamp(3rem, 7vw, 4.5rem);
    max-width: 70rem;
  }

  .hero__eyebrow {
    color: #fff;
    white-space: nowrap;
    margin-bottom: 1rem;
  }

  .hero__title {
    color: var(--accent);
    /* h1 sets text-wrap: balance, which evens the lines into four.
       Fill naturally instead so the measure controls the break. */
    text-wrap: wrap;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-transform: uppercase;
    max-width: 100%;
    margin-bottom: 1.25rem;
  }

  .hero__copy {
    margin-bottom: 1.9rem;
  }

  .hero__copy p {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    max-width: 38rem;
    margin-bottom: 0.9rem;
  }

  .hero__copy p:last-child {
    margin-bottom: 0;
  }

  .hero__cta {
    font-size: 1.05rem;
    padding: 1rem 1.9rem;
  }

  .hero__note {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__note a {
    color: #fff;
    text-decoration: underline;
  }

  /* ---------- RO Insight showcase ---------- */

  .ro {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background:
      radial-gradient(ellipse 55% 60% at 78% 42%, rgba(0, 185, 245, 0.2), transparent 62%),
      linear-gradient(118deg, transparent 52%, rgba(255, 255, 255, 0.035) 52%, rgba(255, 255, 255, 0.035) 74%, transparent 74%),
      linear-gradient(160deg, #06224a 0%, #0a2f63 55%, #051d40 100%);
  }

  .ro__wrap {
    width: min(100% - 2.5rem, 1300px);
  }

  .ro__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .ro__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }

  .ro__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ro__product {
    margin: 0 0 1.4rem;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .ro__product span {
    color: var(--accent);
  }

  .ro__title span {
    display: block;
  }

  .ro__title {
    color: #fff;
    font-size: clamp(2rem, 3.3vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.4rem;
  }

  .ro__lede {
    color: #a9cdf0;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    max-width: 34ch;
    margin-bottom: 1.8rem;
  }

  .ro__chips {
    list-style: none;
    margin: 0 0 2.2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.85rem 2.5rem;
  }

  @media (max-width: 480px) {
    .ro__chips {
      grid-template-columns: 1fr;
    }
  }

  .ro__chips li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.02rem;
    color: #e6f1fb;
  }

  .ro__chip-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent);
    flex: none;
  }

  .ro__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.7rem;
    font-size: 1.05rem;
  }

  .ro__btn-icon {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ro__btn:hover .ro__btn-icon {
    transform: translateX(3px);
  }

  /* ---- the tilted screen ---- */

  .ro__visual {
    position: relative;
    margin: 0;
  }

  .ro__frame {
    background: #0a0e19;
    border: 1px solid rgba(0, 185, 245, 0.35);
    border-radius: 12px;
    padding: 0 0.7rem 0.7rem;
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.65),
      0 0 70px -10px rgba(0, 185, 245, 0.3);
  }

  .ro__bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.2rem;
  }

  .ro__bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #33415a;
  }

  .ro__bar span:first-child {
    background: #e0564f;
  }

  .ro__frame img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .ro__card {
    background: #0b1426;
    border: 1px solid rgba(0, 185, 245, 0.55);
    border-radius: 10px;
    padding: 0.8rem 0.8rem 0.9rem;
    margin-top: 1rem;
    box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.7), 0 0 40px -12px rgba(0, 185, 245, 0.45);
  }

  .ro__card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .ro__card-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
  }

  .ro__card img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .ro__visual figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Perspective only where there is room for it; flat and stacked below. */
  @media (min-width: 960px) {
    /* The tilt enlarges the near (right) edge, so the screen is pulled in
       from the column edge to keep its frame inside the viewport. */
    .ro__visual {
      margin-right: 2.5rem;
    }

    .ro__frame {
      transform: perspective(1600px) rotateY(-17deg) rotateX(4deg);
      transform-origin: left center;
    }

    .ro__card {
      position: absolute;
      right: -2.25rem;
      bottom: 2.2rem;
      width: 46%;
      margin: 0;
    }

    .ro__visual figcaption {
      margin-top: 1.6rem;
    }
  }

  /* ---- feature row ---- */

  .ro__features {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 820px) {
    .ro__features {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

