---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const sectors = [
  {
    slug: 'industrial-water-treatment',
    title: 'Industrial Water Treatment',
    summary:
      'Process water that meets specification consistently — clarification, filtration, reverse osmosis, ion exchange and disinfection.',
  },
  {
    slug: 'wastewater-treatment',
    title: 'Wastewater Treatment',
    summary:
      'Effluent schemes that hold their discharge consent, from primary settlement and biological treatment through to tertiary polishing.',
  },
  {
    slug: 'anaerobic-digestion',
    title: 'Anaerobic Digestion & Sludge',
    summary:
      'Digestion, thermal hydrolysis, dewatering and sludge disposal routes — assessed on whole-life cost, not headline capex.',
  },
];

const reasons = [
  {
    title: 'We do not sell equipment',
    body: 'We have no vendor agreements and no commission arrangements. When we recommend a technology, it is because it fits your water, your site and your budget.',
  },
  {
    title: 'Whole-life cost, not headline capex',
    body: 'Chemical dose, energy, membrane replacement and sludge disposal usually dwarf the purchase price. We model the cost you will actually live with.',
  },
  {
    title: 'Compliance built in from the start',
    body: 'Discharge consents, trade effluent agreements and environmental permitting are designed into the scheme, not retrofitted after commissioning.',
  },
];
---

<Base
  title="Water & Wastewater Treatment Consultants | Waterna"
  description="Independent UK water and wastewater treatment consultancy. Feasibility studies, process design, HAZOP and plant optimisation — vendor-neutral advice, no equipment sales."
>
  <section class="hero">
    <picture>
      <source
        type="image/webp"
        srcset="/img/hero-clarifier-dusk-1200.webp 1200w, /img/hero-clarifier-dusk-1600.webp 1600w, /img/hero-clarifier-dusk-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/hero-clarifier-dusk-1600.jpg"
        alt="A wastewater clarifier bridge at dusk, its walkway reflected in still water"
        width="2000"
        height="917"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__scrim"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Independent UK consultancy</p>
      <h1 class="hero__title">Water treatment without a vendor agenda</h1>
      <p class="hero__lede">
        Independent process engineering for water, effluent and sludge. More than 15 years designing
        new plant, fixing plant that underperforms, and saying so when you do not need to spend the
        money.
      </p>
      <a class="btn btn--primary hero__cta" href={site.phoneHref}>Call {site.phone}</a>
      <p class="hero__note">
        Or email <a href={`mailto:${site.email}`}>{site.email}</a> — no charge for an initial conversation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>Services</h2>
      <p class="lede">
        From the first feasibility question through to a commissioned plant and trained operators.
      </p>

      <div class="grid grid--3">
        {
          services.map((s) => (
            <article class="card">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/services/${s.slug}`}>Read more &rarr;</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Why Waterna</p>
      <h2>Independent means independent</h2>

      <div class="grid grid--3">
        {
          reasons.map((r) => (
            <div>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Where we work</p>
      <h2>Sectors</h2>

      <div class="grid grid--3">
        {
          sectors.map((s) => (
            <article class="card">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/sectors/${s.slug}`}>Read more &rarr;</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <div>
        <h2>Got a treatment problem worth a second opinion?</h2>
        <p>
          Tell us the water, the flow and the consent you are working to. We will tell you whether
          there is a project here — and roughly what it should cost.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={site.phoneHref}>{site.phone}</a>
        <a class="btn btn--ghost" href="/contact">Contact page</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(30rem, 68vh, 45rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero picture,
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero img {
    object-fit: cover;
    object-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(0, 22, 44, 0.88) 0%,
      rgba(0, 22, 44, 0.66) 42%,
      rgba(0, 22, 44, 0.14) 78%
    );
  }

  .hero__inner {
    padding-block: clamp(3rem, 8vw, 5rem);
    max-width: 60rem;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.82);
    white-space: nowrap;
  }

  .hero__title {
    color: #fff;
    /* h1 sets text-wrap: balance, which evens the lines into four.
       Fill naturally instead so the measure controls the break. */
    text-wrap: wrap;
    font-size: clamp(2.4rem, 6.2vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-transform: uppercase;
    max-width: 52rem;
    margin-bottom: 1.1rem;
  }

  .hero__lede {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    max-width: 48ch;
    margin-bottom: 1.9rem;
  }

  .hero__cta {
    font-size: 1.05rem;
    padding: 1rem 1.9rem;
  }

  .hero__note {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__note a {
    color: #fff;
    text-decoration: underline;
  }

  /* ---------- closing CTA ---------- */

  .cta {
    background: var(--brand-tint);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .cta__inner {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .cta h2 {
    margin-bottom: 0.4rem;
  }

  .cta p {
    margin-bottom: 0;
    max-width: 54ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
