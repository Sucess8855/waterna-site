---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projectEngineering, plantPerformance, softwareProducts, serviceHref, hasPage } from '../data/services';
import { pillars } from '../data/pillars';
import { sectors } from '../data/sectors';

const reasons = [
  {
    title: 'Independent of equipment suppliers',
    body: 'We hold no vendor agreements and receive no supplier commissions. Our recommendations are based on your process requirements, operating conditions and project objectives. Our own software is optional, and available separately from our consultancy services.',
  },
  {
    title: 'Whole-life cost in focus',
    body: 'We assess capital and operating costs together — energy, chemicals, maintenance, membrane replacement and sludge disposal — so you can compare options over the life of the plant rather than at the point of purchase.',
  },
  {
    title: 'Compliance considered from the outset',
    body: 'Discharge limits, water quality specifications and permitting requirements are built into process assessment and design, so the constraints surface early rather than at commissioning.',
  },
];
---

<Base
  title="Water Treatment Consultants | UF &amp; RO Desalination | Waterna"
  description="Independent UK water and wastewater consultancy with specialist expertise in ultrafiltration and RO desalination. Feasibility, process design, HAZOP, plant optimisation and RO Insight software."
>
  <section class="hero">
    <picture>
      <source
        type="image/webp"
        srcset="/img/hero-clarifier-dusk-1200.webp 1200w, /img/hero-clarifier-dusk-1600.webp 1600w, /img/hero-clarifier-dusk-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/hero-clarifier-dusk-1600.jpg"
        alt="A wastewater clarifier bridge at dusk, its walkway reflected in still water"
        width="2000"
        height="917"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__scrim"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Independent water and wastewater consultancy</p>
      <h1 class="hero__title">Water treatment expertise</h1>
      <div class="hero__copy">
        <p>
          We help clients design, operate and improve water, wastewater and sludge treatment systems,
          with specialist expertise in ultrafiltration&nbsp;(UF) and reverse osmosis&nbsp;(RO)
          desalination.
        </p>
        <p>
          Drawing on more than 20 years of process engineering experience, we combine technical
          expertise with practical operational insight to improve plant performance, guide investment
          decisions and reduce whole-life costs.
        </p>
      </div>
      <a class="btn btn--primary hero__cta" href="/contact">Discuss your project</a>
      <p class="hero__note">
        Call <a href={site.phoneHref}>{site.phone}</a> or email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a> for a no-obligation initial discussion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>From project development to <span class="hl">plant performance</span></h2>
      <p class="lede">
        Whether you are developing a new treatment scheme or improving an existing plant, we provide
        engineering support to help you assess options, resolve problems and make informed decisions.
      </p>

      <div class="fork">
        {
          pillars.map((p) => {
            const members = p.slug === 'project-engineering' ? projectEngineering : plantPerformance;
            return (
              <article class="fork__card card--lift">
                {
                  p.image && (
                    <a class="fork__media" href={`/${p.slug}`} tabindex="-1" aria-hidden="true">
                      <picture>
                        <source
                          type="image/webp"
                          srcset={`/img/pillars/${p.image}-600.webp 600w, /img/pillars/${p.image}-1200.webp 1200w`}
                          sizes="(min-width: 820px) 46vw, 100vw"
                        />
                        <img
                          src={`/img/pillars/${p.image}-1200.jpg`}
                          alt=""
                          width="1200"
                          height="462"
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </a>
                  )
                }
                <div class="fork__body">
                <p class="fork__strap">{p.strapline}</p>
                <h3>
                  <a href={`/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="fork__summary">{p.summary}</p>
                <ul class="fork__list">
                  {members.map((s) => (
                    <li>
                      {hasPage(s) ? (
                        <a href={serviceHref(s)}>{s.navTitle ?? s.title}</a>
                      ) : (
                        <span>{s.navTitle ?? s.title}</span>
                      )}
                    </li>
                  ))}
                </ul>
                <a class="btn btn--ghost" href={`/${p.slug}`}>
                  Explore {p.title}
                </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sectors</p>
      <h2>Expertise across water, wastewater and <span class="hl">sludge treatment</span></h2>

      <div class="grid grid--2 secgrid">
        {
          sectors.map((s) => (
            <article class="seccard card--lift">
              <a class="seccard__media" href={`/sectors/${s.slug}`} tabindex="-1" aria-hidden="true">
                <picture>
                  <source
                    type="image/webp"
                    srcset={`/img/sectors/${s.image}-600.webp 600w, /img/sectors/${s.image}-1200.webp 1200w`}
                    sizes="(min-width: 820px) 46vw, 100vw"
                  />
                  <img
                    src={`/img/sectors/${s.image}-1200.jpg`}
                    alt=""
                    width="1200"
                    height="674"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="seccard__body">
                <h3>{s.title}</h3>
                <p>{s.summary}</p>
                {
                  s.slug === 'uf-ro-desalination' && (
                    <p class="seccard__extra">
                      For RO plants, Waterna RO Insight™ adds ongoing performance monitoring and
                      diagnostics to support cleaning decisions, energy optimisation and membrane
                      management.
                    </p>
                  )
                }
                <p class="seccard__links">
                  <a href={`/sectors/${s.slug}`}>Explore {s.navTitle ?? s.title}</a>
                  {
                    s.slug === 'uf-ro-desalination' && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <a href="/ro-insight">Discover RO Insight™</a>
                      </>
                    )
                  }
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="digital">
    <div class="wrap">
      <p class="eyebrow digital__eyebrow">Software &amp; Analytics</p>
      <h2>Turn operating data into <span class="hl hl--light">informed decisions</span></h2>
      <p class="digital__lede">
        Our software combines process engineering methods with data analysis, so operating teams can
        track performance, recognise developing problems and plan corrective action.
      </p>

      <div class="digital__products">
        {
          softwareProducts.map((s) => (
            <article class="pcard">
              <p class="pcard__tag">Software platform</p>
              <h3>
                <a href={serviceHref(s)}>{s.title}</a>
              </h3>
              <p>{s.summary}</p>
              <ul class="pcard__list">
                {s.covered.slice(0, 6).map(([term]) => <li>{term}</li>)}
              </ul>
              <a class="btn btn--light" href={serviceHref(s)}>
                Explore {s.navTitle ?? s.title}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap">
      <p class="eyebrow">Why Waterna</p>
      <h2>Independent advice. <span class="hl">Practical engineering.</span></h2>

      <div class="grid grid--3 reasons">
        {
          reasons.map((r, i) => (
            <article class="reason">
              <span class="reason__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="photoband">
    <picture>
      <source
        type="image/webp"
        srcset="/img/band-plant-1200.webp 1200w, /img/band-plant-1600.webp 1600w, /img/band-plant-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/band-plant-1600.jpg"
        alt="Pump hall inside a water treatment plant"
        width="2000"
        height="917"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="photoband__scrim"></div>
    <div class="wrap photoband__inner">
      <h2>Discuss your project with an <span class="hl hl--light">engineer</span></h2>
      <p>
        Speak directly with a process engineer about your treatment requirements, operating
        challenges or planned investment. We will help clarify the problem, identify the information
        needed and agree a practical next step.
      </p>
      <a class="btn btn--light" href="/contact">Contact us</a>
    </div>
  </section>

</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(30rem, 68vh, 45rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero picture,
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero img {
    object-fit: cover;
    object-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(0, 22, 44, 0.92) 0%,
      rgba(0, 22, 44, 0.86) 50%,
      rgba(0, 22, 44, 0.66) 78%,
      rgba(0, 22, 44, 0.3) 100%
    );
  }

  .hero__inner {
    padding-block: clamp(3rem, 7vw, 4.5rem);
    max-width: 70rem;
  }

  .hero__eyebrow {
    color: #fff;
    white-space: nowrap;
    margin-bottom: 1rem;
  }

  .hero__title {
    color: var(--accent);
    /* h1 sets text-wrap: balance, which evens the lines into four.
       Fill naturally instead so the measure controls the break. */
    text-wrap: wrap;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-transform: uppercase;
    max-width: 100%;
    margin-bottom: 1.25rem;
  }

  .hero__copy {
    margin-bottom: 1.9rem;
  }

  .hero__copy p {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    max-width: 38rem;
    margin-bottom: 0.9rem;
  }

  .hero__copy p:last-child {
    margin-bottom: 0;
  }

  .hero__cta {
    font-size: 1.05rem;
    padding: 1rem 1.9rem;
  }

  .hero__note {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__note a {
    color: #fff;
    text-decoration: underline;
  }

  /* ---------- data & digital ---------- */

  .digital {
    background: var(--brand-deep);
    color: rgba(255, 255, 255, 0.86);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .digital :global(h2) {
    color: #fff;
    max-width: 22ch;
  }

  .digital__eyebrow {
    color: var(--accent);
  }

  .digital__lede {
    font-size: 1.125rem;
    max-width: 56ch;
    margin-bottom: 0;
  }

  .digital__products {
    margin-top: 2.25rem;
    display: grid;
    gap: 1.5rem;
  }

  .pcard {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .pcard__tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.22rem 0.55rem;
    margin: 0 0 0.8rem;
  }

  .pcard :global(h3) {
    color: #fff;
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    margin-bottom: 0.5rem;
  }

  .pcard :global(h3 a) {
    color: #fff;
    text-decoration: none;
  }

  .pcard :global(h3 a:hover) {
    color: var(--accent);
  }

  .pcard > p {
    max-width: 62ch;
    margin-bottom: 1.25rem;
  }

  .pcard__list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 620px) {
    .pcard__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pcard__list :global(li) {
    font-size: 0.9rem;
    color: #fff;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 3px;
    margin: 0;
  }

  .dcard {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    padding: 1.6rem;
  }

  .dcard :global(h3) {
    color: #fff;
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .dcard :global(h3 a) {
    color: #fff;
    text-decoration: none;
  }

  .dcard :global(h3 a:hover) {
    color: var(--accent);
  }

  .dcard p {
    font-size: 0.98rem;
    margin-bottom: 0.9rem;
  }

  .dcard__tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-deep);
    background: var(--accent);
    border-radius: 3px;
    padding: 0.22rem 0.55rem;
    margin: 0 0 0.7rem;
  }

  .dcard__more {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .dcard__more:hover {
    text-decoration: underline;
  }

  /* ---------- why waterna ---------- */

  .reasons {
    margin-top: 2.25rem;
  }

  .reason {
    position: relative;
    background: #fff;
    border: 1px solid #d3e1d7;
    border-radius: 4px;
    padding: 1.9rem 1.75rem 1.75rem;
    box-shadow: 0 2px 40px -16px rgba(0, 63, 118, 0.22);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reason:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px -16px rgba(0, 63, 118, 0.34);
  }

  .reason__num {
    display: block;
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1;
    color: var(--ember);
    opacity: 0.3;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .reason :global(h3) {
    font-size: 1.15rem;
    margin-bottom: 0.45rem;
  }

  .reason p {
    margin-bottom: 0;
    font-size: 0.97rem;
  }

  /* ---------- sector cards ---------- */

  .secgrid {
    margin-top: 2.25rem;
  }

  .seccard {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .seccard__media {
    display: block;
  }

  .seccard__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .seccard__body {
    padding: 1.5rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .seccard :global(h3) {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .seccard__body > p {
    font-size: 0.98rem;
  }

  .seccard__extra {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .seccard__links {
    margin-top: auto;
    margin-bottom: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .seccard__links :global(a) {
    text-decoration: none;
  }

  .seccard__links :global(a:hover) {
    text-decoration: underline;
  }

  /* ---------- the fork ---------- */

  .fork {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 820px) {
    .fork {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .fork__card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .fork__media {
    display: block;
  }

  .fork__media :global(img) {
    width: 100%;
    aspect-ratio: 2.6 / 1;
    object-fit: cover;
  }

  .fork__body {
    padding: 1.75rem 1.85rem 1.85rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .fork__strap {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  .fork__card :global(h3) {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    margin-bottom: 0.6rem;
  }

  .fork__card :global(h3 a) {
    text-decoration: none;
    color: var(--ink);
  }

  .fork__card :global(h3 a:hover) {
    color: var(--brand);
  }

  .fork__summary {
    max-width: 46ch;
  }

  .fork__list {
    list-style: none;
    margin: 0.5rem 0 1.75rem;
    padding: 0;
    border-top: 1px solid var(--line);
    flex: 1;
  }

  .fork__list :global(li) {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .fork__list :global(a),
  .fork__list :global(span) {
    display: block;
    padding: 0.65rem 0;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
  }

  /* Listed but not yet written up — muted so it does not read as a
     dead link. */
  .fork__list :global(span) {
    color: var(--body);
    font-weight: 500;
  }

  .fork__list :global(a:hover) {
    text-decoration: underline;
  }

  .fork__card :global(.btn) {
    align-self: flex-start;
  }

  /* ---------- numbered service cards ---------- */

  .scards {
    margin-top: 2.25rem;
  }

  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .scard__num {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ember);
    display: block;
    margin-bottom: 0.55rem;
  }

  .scard :global(h3) {
    margin-bottom: 0.4rem;
  }

  .scard :global(h3 a) {
    color: var(--ink);
    text-decoration: none;
  }

  .scard :global(h3 a:hover) {
    color: var(--brand);
  }

  .scard > p {
    flex: 1;
  }

  .scard__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .scard__tags li {
    font-size: 0.76rem;
    color: var(--body);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.2rem 0.5rem;
    margin: 0;
  }

  .scard__more {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .scard__more:hover {
    text-decoration: underline;
  }

  /* ---------- photo CTA band ---------- */

  .photoband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(21rem, 38vh, 27rem);
  }

  .photoband picture,
  .photoband img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .photoband img {
    object-fit: cover;
    object-position: center 50%;
  }

  .photoband__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 22, 44, 0.88) 0%, rgba(0, 22, 44, 0.7) 50%, rgba(0, 22, 44, 0.55) 100%);
  }

  .photoband__inner {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }

  .photoband :global(h2) {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .photoband p {
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 1.6rem;
    max-width: 58ch;
  }

  .photoband :global(.hl--light) {
    color: var(--accent);
  }

</style>
