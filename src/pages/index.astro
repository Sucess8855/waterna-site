---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { engineeringServices, digitalServices } from '../data/services';

const sectors = [
  {
    slug: 'industrial-water-treatment',
    title: 'Industrial Water Treatment',
    summary:
      'Process water that meets specification consistently — clarification, filtration, reverse osmosis, ion exchange and disinfection.',
  },
  {
    slug: 'wastewater-treatment',
    title: 'Wastewater Treatment',
    summary:
      'Effluent schemes that hold their discharge consent, from primary settlement and biological treatment through to tertiary polishing.',
  },
  {
    slug: 'anaerobic-digestion',
    title: 'Anaerobic Digestion & Sludge',
    summary:
      'Digestion, thermal hydrolysis, dewatering and sludge disposal routes — assessed on whole-life cost, not headline capex.',
  },
];

const reasons = [
  {
    title: 'We specify no equipment',
    body: 'We hold no vendor agreements and take no commission from suppliers. Our own software is the one thing we sell, it is entirely optional, and it works with any manufacturer’s membranes.',
  },
  {
    title: 'Whole-life cost, not headline capex',
    body: 'Chemical dose, energy, membrane replacement and sludge disposal usually dwarf the purchase price. We model the cost you will actually live with.',
  },
  {
    title: 'Compliance built in from the start',
    body: 'Discharge consents, trade effluent agreements and environmental permitting are designed into the scheme, not retrofitted after commissioning.',
  },
];
---

<Base
  title="Water & Wastewater Treatment Consultants | Waterna"
  description="Independent UK water and wastewater treatment consultancy. Feasibility studies, process design, HAZOP and plant optimisation — vendor-neutral advice, no equipment sales."
>
  <section class="hero">
    <picture>
      <source
        type="image/webp"
        srcset="/img/hero-clarifier-dusk-1200.webp 1200w, /img/hero-clarifier-dusk-1600.webp 1600w, /img/hero-clarifier-dusk-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/hero-clarifier-dusk-1600.jpg"
        alt="A wastewater clarifier bridge at dusk, its walkway reflected in still water"
        width="2000"
        height="917"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__scrim"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Independent UK consultancy</p>
      <h1 class="hero__title">Water treatment without a vendor agenda</h1>
      <p class="hero__lede">
        Independent process engineering for water, effluent and sludge. More than 15 years designing
        new plant, fixing plant that underperforms, and saying so when you do not need to spend the
        money.
      </p>
      <a class="btn btn--primary hero__cta" href={site.phoneHref}>Call {site.phone}</a>
      <p class="hero__note">
        Or email <a href={`mailto:${site.email}`}>{site.email}</a> — no charge for an initial conversation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>Engineering <span class="hl">services</span></h2>
      <p class="lede">
        From the first feasibility question through to a commissioned plant and trained operators.
      </p>

      <div class="grid grid--3 scards">
        {
          engineeringServices.map((s, i) => (
            <article class="card scard">
              <span class="scard__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                <a href={`/services/${s.slug}`}>{s.navTitle ?? s.title}</a>
              </h3>
              <p>{s.summary}</p>
              <ul class="scard__tags">
                {s.covered.slice(0, 2).map(([term]) => <li>{term}</li>)}
              </ul>
              <a class="scard__more" href={`/services/${s.slug}`}>Read more &rarr;</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="digital">
    <div class="wrap">
      <p class="eyebrow digital__eyebrow">Data &amp; digital</p>
      <h2>We also read the data your plant already produces</h2>
      <p class="digital__lede">
        Every plant records more than enough to explain its own behaviour. Most of it is never read
        against what the process ought to be doing.
      </p>

      <div class="grid grid--2 digital__grid">
        {
          digitalServices.map((s) => (
            <article class="dcard">
              {s.kind === 'product' && <p class="dcard__tag">Software platform</p>}
              <h3>
                <a href={`/services/${s.slug}`}>{s.title}</a>
              </h3>
              <p>{s.summary}</p>
              <a class="dcard__more" href={`/services/${s.slug}`}>
                Read more &rarr;
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Why Waterna</p>
      <h2>Independent means <span class="hl">independent</span></h2>

      <div class="grid grid--3">
        {
          reasons.map((r) => (
            <div>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Where we work</p>
      <h2>Where we <span class="hl">work</span></h2>

      <div class="grid grid--3">
        {
          sectors.map((s) => (
            <article class="card">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/sectors/${s.slug}`}>Read more &rarr;</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="photoband">
    <picture>
      <source
        type="image/webp"
        srcset="/img/band-plant-1200.webp 1200w, /img/band-plant-1600.webp 1600w, /img/band-plant-2000.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/img/band-plant-1600.jpg"
        alt="Pump hall inside a water treatment plant"
        width="2000"
        height="917"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="photoband__scrim"></div>
    <div class="wrap photoband__inner">
      <h2>Talk to an <span class="hl hl--light">engineer</span></h2>
      <p>Not a sales desk. The first conversation costs nothing.</p>
      <a class="btn btn--primary" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <div>
        <h2>Got a treatment problem worth a second opinion?</h2>
        <p>
          Tell us the water, the flow and the consent you are working to. We will tell you whether
          there is a project here — and roughly what it should cost.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={site.phoneHref}>{site.phone}</a>
        <a class="btn btn--ghost" href="/contact">Contact page</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(30rem, 68vh, 45rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero picture,
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero img {
    object-fit: cover;
    object-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(0, 22, 44, 0.88) 0%,
      rgba(0, 22, 44, 0.66) 42%,
      rgba(0, 22, 44, 0.14) 78%
    );
  }

  .hero__inner {
    padding-block: clamp(3rem, 8vw, 5rem);
    max-width: 60rem;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.82);
    white-space: nowrap;
  }

  .hero__title {
    color: #fff;
    /* h1 sets text-wrap: balance, which evens the lines into four.
       Fill naturally instead so the measure controls the break. */
    text-wrap: wrap;
    font-size: clamp(2.4rem, 6.2vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-transform: uppercase;
    max-width: 52rem;
    margin-bottom: 1.1rem;
  }

  .hero__lede {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    max-width: 48ch;
    margin-bottom: 1.9rem;
  }

  .hero__cta {
    font-size: 1.05rem;
    padding: 1rem 1.9rem;
  }

  .hero__note {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__note a {
    color: #fff;
    text-decoration: underline;
  }

  /* ---------- data & digital ---------- */

  .digital {
    background: var(--brand-deep);
    color: rgba(255, 255, 255, 0.86);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .digital :global(h2) {
    color: #fff;
    max-width: 22ch;
  }

  .digital__eyebrow {
    color: var(--accent);
  }

  .digital__lede {
    font-size: 1.125rem;
    max-width: 56ch;
    margin-bottom: 0;
  }

  .digital__grid {
    margin-top: 2.25rem;
  }

  .dcard {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    padding: 1.6rem;
  }

  .dcard :global(h3) {
    color: #fff;
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .dcard :global(h3 a) {
    color: #fff;
    text-decoration: none;
  }

  .dcard :global(h3 a:hover) {
    color: var(--accent);
  }

  .dcard p {
    font-size: 0.98rem;
    margin-bottom: 0.9rem;
  }

  .dcard__tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-deep);
    background: var(--accent);
    border-radius: 3px;
    padding: 0.22rem 0.55rem;
    margin: 0 0 0.7rem;
  }

  .dcard__more {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .dcard__more:hover {
    text-decoration: underline;
  }

  /* ---------- numbered service cards ---------- */

  .scards {
    margin-top: 2.25rem;
  }

  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .scard__num {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ember);
    display: block;
    margin-bottom: 0.55rem;
  }

  .scard :global(h3) {
    margin-bottom: 0.4rem;
  }

  .scard :global(h3 a) {
    color: var(--ink);
    text-decoration: none;
  }

  .scard :global(h3 a:hover) {
    color: var(--brand);
  }

  .scard > p {
    flex: 1;
  }

  .scard__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .scard__tags li {
    font-size: 0.76rem;
    color: var(--body);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.2rem 0.5rem;
    margin: 0;
  }

  .scard__more {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .scard__more:hover {
    text-decoration: underline;
  }

  /* ---------- photo CTA band ---------- */

  .photoband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(18rem, 32vh, 24rem);
  }

  .photoband picture,
  .photoband img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .photoband img {
    object-fit: cover;
    object-position: center 50%;
  }

  .photoband__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 22, 44, 0.88) 0%, rgba(0, 22, 44, 0.7) 50%, rgba(0, 22, 44, 0.55) 100%);
  }

  .photoband__inner {
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }

  .photoband :global(h2) {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .photoband p {
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 1.5rem;
    max-width: 48ch;
  }

  .photoband :global(.hl--light) {
    color: var(--accent);
  }

  /* ---------- closing CTA ---------- */

  .cta {
    background: var(--brand-tint);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .cta__inner {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .cta h2 {
    margin-bottom: 0.4rem;
  }

  .cta p {
    margin-bottom: 0;
    max-width: 54ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
