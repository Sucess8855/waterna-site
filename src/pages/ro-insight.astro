---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { roInsight, pagedServices, serviceHref } from '../data/services';
import { serviceIcons } from '../data/icons';

const svg = (paths: string, cls: string, width = 1.5) =>
  `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const arrow = svg('<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>', 'ri-arrow', 2);
const check =
  '<svg class="ri-check" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11"></circle><path d="m7.5 12.5 3 3 6-6.5"></path></svg>';

const gear =
  '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>';
const bars =
  '<path d="M4 20h16"/><rect x="5" y="13" width="3" height="7"/><rect x="10.5" y="8" width="3" height="12"/><rect x="16" y="3" width="3" height="17"/>';

const audiences = [
  {
    title: 'Operations',
    text: 'Understand current performance and investigate changes.',
    icon: gear,
  },
  {
    title: 'Maintenance',
    text: 'Review membrane trends and cleaning effectiveness.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  { title: 'Management', text: 'Assess energy use and prioritise improvement opportunities.', icon: bars },
];

const ways = [
  {
    title: 'Membrane health',
    text: 'Track permeability, salt passage and performance changes.',
    icon: '<rect x="4.5" y="3" width="6" height="18" rx="3"/><rect x="13.5" y="3" width="6" height="18" rx="3"/><path d="M7.5 7v10M16.5 7v10"/>',
  },
  {
    title: 'CIP performance',
    text: 'Compare cleaning recovery and review developing trends.',
    icon: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  },
  {
    title: 'Scaling assessment',
    text: 'Review calculated risk using available feedwater chemistry.',
    icon: '<circle cx="12" cy="5.5" r="2.5"/><circle cx="5.5" cy="17.5" r="2.5"/><circle cx="18.5" cy="17.5" r="2.5"/><path d="M11 7.8 6.8 15.3M13 7.8l4.2 7.5M8 17.5h8"/>',
  },
  {
    title: 'Energy performance',
    text: 'Assess specific energy use and potential operating improvements.',
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  },
  {
    title: 'Train & fleet comparison',
    text: 'Compare compatible trains under appropriate reference conditions.',
    icon: bars,
  },
];

const steps = [
  { title: 'Review your data', text: 'Identify available tags, history and data gaps.' },
  { title: 'Configure the assessment', text: 'Agree rack mapping, baselines and relevant modules.' },
  { title: 'Explore the results', text: 'Review findings and deployment requirements together.' },
];

const glance: [string, string][][] = [
  [
    ['Purpose', 'RO performance monitoring and decision support'],
    ['Data', 'Historical exports or agreed live interfaces'],
    ['Deployment', 'On-premise or cloud options'],
  ],
  [
    ['AI assistant', 'Offline, on-premise configuration'],
    ['ML model', 'Models trained on your own plant data'],
    ['Commercial model', 'Licence or subscription'],
  ],
];

const related = ['plant-optimisation', 'chemical-dosing-cip', 'data-analysis']
  .map((slug) => pagedServices.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={roInsight.metaTitle} description={roInsight.metaDescription}>
  <!-- ---------- hero ---------- -->
  <section class="ri-hero">
    <div class="wrap ri-hero__grid">
      <div>
        <nav class="ri-crumbs" aria-label="Breadcrumb">
          <a href="/software">Software</a>
          <span aria-hidden="true">/</span>
          <span>RO Insight™</span>
        </nav>
        <p class="ri-product">Waterna RO Insight™</p>
        <h1>
          <span class="ri-line">Understand performance.</span>
          <span class="ri-line">Plan your next move.</span>
        </h1>
        <p class="ri-hero__lede">
          Turn routine RO plant data into engineering insight for membrane health, cleaning decisions
          and energy performance.
        </p>
        <div class="ri-hero__actions">
          <a class="btn btn--light ri-btn" href="/contact">Request a walkthrough <Fragment set:html={arrow} /></a>
        </div>
        <ul class="ri-stats">
          <li>100+ engineering indicators</li>
          <li>Multi-rack analysis</li>
          <li>Offline AI assistant</li>
        </ul>
      </div>

      <figure class="ri-screen">
        <div class="ri-frame">
          <div class="ri-frame__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <picture>
            <source
              type="image/webp"
              srcset="/img/ro-insight/dash-full-900.webp 900w, /img/ro-insight/dash-full-1400.webp 1400w"
              sizes="(min-width: 960px) 50vw, 100vw"
            />
            <img
              src="/img/ro-insight/dash-full-1400.jpg"
              alt="RO Insight live dashboard: plant status, fleet KPI snapshot and diagnostic overview"
              width="1400"
              height="795"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
        <figcaption>The RO Insight™ live dashboard</figcaption>
      </figure>
    </div>
  </section>

  <!-- ---------- audiences ---------- -->
  <section class="ri-audience">
    <div class="wrap">
      <h2 class="ri-center">One engineering view across your team</h2>
      <ul class="ri-audience__list">
        {
          audiences.map((a) => (
            <li>
              <span class="ri-badge"><Fragment set:html={svg(a.icon, 'ri-badge__icon')} /></span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---------- five ways ---------- -->
  <section class="ri-ways">
    <div class="wrap">
      <h2 class="ri-center">Five ways to understand your RO plant</h2>
      <ol class="ri-ways__list">
        {
          ways.map((w, i) => (
            <li>
              <span class="ri-ways__num">{pad(i + 1)}</span>
              <div class="ri-ways__body">
                <span class="ri-badge ri-badge--sm"><Fragment set:html={svg(w.icon, 'ri-badge__icon')} /></span>
                <div>
                  <h3>{w.title}</h3>
                  <p>{w.text}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="ri-ways__note">
        Findings linked to operating data, calculation methods and configured baselines.
      </p>
    </div>
  </section>

  <!-- ---------- AI assistant ---------- -->
  <section class="ri-ai">
    <div class="wrap ri-ai__grid">
      <div>
        <p class="ri-eyebrow">Built-in AI assistant</p>
        <h2>
          <span class="ri-line">Ask questions.</span>
          <span class="ri-line">Keep analysis on site.</span>
        </h2>
        <p class="ri-ai__text">
          Explore rack performance, KPI changes and potential causes through an assistant configured to
          run on your own hardware.
        </p>
        <ul class="ri-ai__checks">
          <li><Fragment set:html={check} />Offline operation</li>
          <li><Fragment set:html={check} />Plant context</li>
          <li><Fragment set:html={check} />Suggested investigation steps</li>
        </ul>
      </div>

      <figure class="ri-screen">
        <div class="ri-frame ri-frame--flat">
          <div class="ri-frame__head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"></path></svg>
            AI Assistant
          </div>
          <picture>
            <source type="image/webp" srcset="/img/ro-insight/assistant-card.webp" />
            <img
              src="/img/ro-insight/assistant-card.png"
              alt="The offline assistant answering: give me a concise summary of the current plant status"
              width="560"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <figcaption>The offline AI assistant in RO Insight™</figcaption>
      </figure>
    </div>
  </section>

  <!-- ---------- how it is set up ---------- -->
  <section class="ri-steps">
    <div class="wrap">
      <h2 class="ri-center">Configured around your plant and data</h2>
      <ol class="ri-steps__list">
        {
          steps.map((s, i) => (
            <li>
              <span class="ri-steps__num">{pad(i + 1)}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- at a glance ---------- -->
  <section class="ri-glance">
    <div class="wrap">
      <h2>At a glance</h2>
      <div class="ri-glance__grid">
        {
          glance.map((col) => (
            <dl>
              {col.map(([term, def]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{def}</dd>
                </div>
              ))}
            </dl>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- call to action ---------- -->
  <section class="ri-cta">
    <div class="wrap ri-cta__grid">
      <div>
        <h2>See what your RO data can tell you.</h2>
        <p>Discuss your plant, available measurements and operating priorities.</p>
      </div>
      <div class="ri-cta__actions">
        <a class="btn btn--light ri-btn" href="/contact">Request a walkthrough <Fragment set:html={arrow} /></a>
        <span class="ri-cta__rule" aria-hidden="true"></span>
        <a class="ri-cta__mail" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
          {site.email}
        </a>
      </div>
    </div>
  </section>

  <!-- ---------- related ---------- -->
  <section class="ri-related">
    <div class="wrap ri-related__row">
      <h2>Related services</h2>
      <ul>
        {
          related.map((r) => (
            <li>
              <a href={serviceHref(r)}>
                <Fragment set:html={svg(serviceIcons[r.slug] ?? '', 'ri-related__icon')} />
                {r.navTitle ?? r.title}
                <Fragment set:html={arrow} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- shared ---------- */

  .ri-center {
    text-align: center;
  }

  h2 {
    color: var(--brand-deep);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 800;
  }

  /* Page-set line breaks, only where there is room for them. */
  @media (min-width: 560px) {
    .ri-line {
      display: block;
    }
  }

  .ri-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ri-btn :global(.ri-arrow) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ri-btn:hover :global(.ri-arrow) {
    transform: translateX(3px);
  }

  .ri-badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: #e2eef9;
    color: var(--brand-deep);
  }

  .ri-badge--sm {
    width: 3rem;
    height: 3rem;
  }

  .ri-badge :global(.ri-badge__icon) {
    width: 55%;
    height: 55%;
  }

  /* ---------- dark bands (hero and assistant) ---------- */

  .ri-hero,
  .ri-ai {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(ellipse 55% 60% at 78% 42%, rgba(0, 185, 245, 0.2), transparent 62%),
      linear-gradient(160deg, #06224a 0%, #0a2f63 55%, #051d40 100%);
  }

  .ri-hero {
    padding-block: clamp(2.75rem, 5vw, 4rem);
  }

  .ri-hero__grid,
  .ri-ai__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .ri-hero__grid,
    .ri-ai__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 3.5rem;
    }
  }

  .ri-crumbs {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a9cdf0;
    margin-bottom: 1rem;
  }

  /* Cyan holds 4.7:1 on the navy ground. */
  .ri-crumbs a {
    color: var(--accent);
    text-decoration: none;
  }

  .ri-crumbs a:hover {
    text-decoration: underline;
  }

  .ri-crumbs span[aria-hidden] {
    margin-inline: 0.5rem;
  }

  .ri-product {
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Sized so each of the two set lines fits the copy column. */
  .ri-hero h1 {
    color: #fff;
    font-size: clamp(2rem, 3.1vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1.1rem;
  }

  .ri-hero__lede {
    color: #d6e6f5;
    font-size: 1.1rem;
    max-width: 44ch;
    margin-bottom: 1.8rem;
  }

  .ri-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }

  .ri-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    font-size: 0.95rem;
    color: #d6e6f5;
  }

  .ri-stats li {
    margin: 0;
  }

  .ri-stats li + li::before {
    content: '•';
    margin-inline: 0.8rem;
    color: var(--accent);
  }

  /* ---- framed product screens ---- */

  .ri-screen {
    margin: 0;
  }

  .ri-frame {
    background: #0a0e19;
    border: 1px solid rgba(0, 185, 245, 0.35);
    border-radius: 12px;
    padding: 0 0.7rem 0.7rem;
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.65),
      0 0 70px -10px rgba(0, 185, 245, 0.3);
  }

  .ri-frame__bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.2rem;
  }

  .ri-frame__bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #33415a;
  }

  .ri-frame__bar span:first-child {
    background: #e0564f;
  }

  .ri-frame__head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 0.3rem;
    font-weight: 700;
    font-size: 0.98rem;
    color: #fff;
  }

  .ri-frame__head svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
  }

  .ri-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .ri-screen figcaption {
    margin-top: 0.9rem;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }

  /* ---------- audiences ---------- */

  .ri-audience {
    padding-block: clamp(2.75rem, 5vw, 3.75rem);
  }

  .ri-audience h2 {
    margin-bottom: 1.8rem;
  }

  .ri-audience__list,
  .ri-ways__list,
  .ri-steps__list,
  .ri-ai__checks,
  .ri-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ri-audience__list {
    display: grid;
    gap: 1.6rem;
  }

  @media (min-width: 820px) {
    .ri-audience__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .ri-audience__list li {
      padding-inline: 2rem;
    }

    .ri-audience__list li:first-child {
      padding-left: 0;
    }

    .ri-audience__list li + li {
      border-left: 1px solid var(--line);
    }
  }

  .ri-audience__list li {
    margin: 0;
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .ri-audience h3,
  .ri-ways h3,
  .ri-steps h3 {
    color: var(--brand-deep);
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .ri-audience p,
  .ri-ways p,
  .ri-steps p {
    margin: 0;
    font-size: 0.98rem;
  }

  /* ---------- five ways ---------- */

  .ri-ways {
    background: #eef5fb;
    border-block: 1px solid #dde9f4;
    padding-block: clamp(2.75rem, 5vw, 3.75rem);
  }

  .ri-ways h2 {
    margin-bottom: 1.6rem;
  }

  .ri-ways__list {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .ri-ways__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Three across, then the last two centred beneath. */
  @media (min-width: 1000px) {
    .ri-ways__list {
      grid-template-columns: repeat(6, 1fr);
    }

    .ri-ways__list li {
      grid-column: span 2;
    }

    .ri-ways__list li:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .ri-ways__list li:nth-child(5) {
      grid-column: 4 / span 2;
    }
  }

  .ri-ways__list li {
    margin: 0;
    background: #fff;
    border: 1px solid #dde9f4;
    border-radius: 4px;
    padding: 1.2rem 1.4rem 1.5rem;
  }

  /* #0A78C2 holds 4.69:1 on white. */
  .ri-ways__num {
    display: inline-block;
    color: #0a78c2;
    font-weight: 700;
    font-size: 1.05rem;
    padding-right: 0.8rem;
    border-right: 1px solid #c9dcee;
    margin-bottom: 0.6rem;
  }

  .ri-ways__body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .ri-ways__note {
    margin: 1.4rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--body);
  }

  /* ---------- AI assistant ---------- */

  .ri-ai {
    padding-block: clamp(2.75rem, 5vw, 4rem);
  }

  .ri-eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ri-ai h2 {
    color: #fff;
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .ri-ai__text {
    color: #d6e6f5;
    font-size: 1.08rem;
    max-width: 44ch;
    margin-bottom: 1.5rem;
  }

  .ri-ai__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
  }

  .ri-ai__checks li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
  }

  .ri-ai__checks :global(.ri-check) {
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
  }

  .ri-ai__checks :global(.ri-check circle) {
    fill: #1a9fe0;
  }

  .ri-ai__checks :global(.ri-check path) {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- steps ---------- */

  .ri-steps {
    padding-block: clamp(2.75rem, 5vw, 3.75rem);
  }

  .ri-steps h2 {
    margin-bottom: 1.8rem;
  }

  .ri-steps__list {
    display: grid;
    gap: 1.6rem;
  }

  .ri-steps__list li {
    margin: 0;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .ri-steps__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #e2eef9;
    color: var(--brand-deep);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .ri-steps p {
    max-width: 28ch;
  }

  /* Arrows sit in the gaps, drawn in CSS so they stay out of the reading order. */
  @media (min-width: 860px) {
    .ri-steps__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 4.5rem;
    }

    .ri-steps__list li {
      position: relative;
    }

    .ri-steps__list li + li::before {
      content: '';
      position: absolute;
      left: -3.4rem;
      top: 0.9rem;
