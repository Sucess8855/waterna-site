---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';

const facts = [
  '15+ years of process engineering experience',
  'Water & wastewater treatment',
  'Independent of equipment suppliers',
];

const glance: [string, string][] = [
  ['Company', site.legalName],
  ['Based in', `${site.address.city}, UK`],
  ['Coverage', 'UK, Europe and the Middle East'],
  ['Focus', 'Process engineering and plant performance'],
];

const principles = [
  { title: 'Independent advice', text: 'No equipment sales, vendor agreements or supplier commissions.' },
  { title: 'Whole-life cost', text: 'Consider investment alongside energy, chemicals, maintenance and disposal.' },
  { title: 'Proportionate improvements', text: 'Assess operational changes alongside options for plant modification.' },
];

const support = [
  { title: 'Project Engineering', href: '/project-engineering', text: 'Assess options, develop process designs and review proposed schemes.' },
  { title: 'Plant Performance', href: '/plant-performance', text: 'Investigate operating problems and support commissioning and improvement.' },
  { title: 'Analytics Software', href: '/software', text: 'Use engineering analysis to support performance monitoring and decisions.' },
];

/* Decorative contour lines for the navy band: a fan of sine curves. */
const waves = Array.from({ length: 10 }, (_, i) => {
  const pts: string[] = [];
  for (let x = 0; x <= 400; x += 10) {
    pts.push(`${x},${(20 + i * 16 + 22 * Math.sin((x / 400) * Math.PI * 2.2 + i * 0.35)).toFixed(1)}`);
  }
  return `M${pts.join(' L')}`;
});
---

<Base
  title="About Waterna | Independent Water Treatment Consultancy"
  description="Waterna is an independent UK water and wastewater treatment consultancy. Process engineering from early assessment and design to plant performance — no equipment sales, no vendor agreements."
>
  <!-- ---------- hero ---------- -->
  <!-- Desktop shows the supplied banner image whole, text included; the
       live text below stays for phones, search engines and screen readers. -->
  <section class="ab-hero">
    <picture class="ab-hero__full" aria-hidden="true">
      <source
        type="image/webp"
        srcset="/img/about/about-full-1600.webp 1600w, /img/about/about-full-2172.webp 2172w"
        sizes="100vw"
      />
      <img src="/img/about/about-full-2172.jpg" alt="" width="2172" height="724" loading="lazy" decoding="async" />
    </picture>
    <picture class="ab-hero__photo">
      <source
        type="image/webp"
        srcset="/img/about/about-banner-1000.webp 1000w, /img/about/about-banner-1600.webp 1600w"
        sizes="100vw"
      />
      <img
        src="/img/about/about-banner-1600.jpg"
        alt="Aerial view of a wastewater treatment works with circular clarifiers and aeration lanes"
        width="1600"
        height="727"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="ab-hero__fade" aria-hidden="true"></div>
    <div class="wrap ab-hero__text">
      <p class="eyebrow">About Waterna</p>
      <h1>
        <span class="ab-line">Independent engineering.</span>{' '}
        <span class="ab-line">Practical understanding.</span>
      </h1>
      <p class="ab-hero__lede">
        Waterna is a UK process engineering consultancy supporting water and wastewater treatment
        projects, from early assessment and design to plant performance and improvement.
      </p>
      <a class="btn btn--primary ab-btn" href="/contact">Discuss your project <Fragment set:html={arrow} /></a>
    </div>
  </section>

  <!-- ---------- facts strip ---------- -->
  <section class="ab-facts">
    <ul class="wrap">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <!-- ---------- experience + glance ---------- -->
  <section class="ab-intro">
    <div class="wrap ab-intro__grid">
      <div>
        <h2>
          <span class="ab-line">Engineering shaped by</span>
          <span class="ab-line">operating experience</span>
        </h2>
        <p>
          Our experience spans industrial water, wastewater and utility systems in manufacturing,
          refining, gas processing and petrochemicals.
        </p>
        <p>
          We assess treatment options against feed variability, site constraints, operating
          capability and whole-life cost.
        </p>
      </div>
      <aside class="ab-glance">
        <h2>Waterna at a glance</h2>
        <dl>
          {
            glance.map(([term, def]) => (
              <div>
                <dt>{term}</dt>
                <dd>{def}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <!-- ---------- principles ---------- -->
  <section class="ab-band">
    <svg class="ab-band__waves" viewBox="0 0 400 200" preserveAspectRatio="none" aria-hidden="true">
      {waves.map((d) => <path d={d} />)}
    </svg>
    <div class="wrap ab-band__inner">
      <h2>Recommendations built around your plant.</h2>
      <p class="ab-band__lede">
        The right approach starts with your water quality, operating conditions and project objectives.
      </p>
      <ol class="ab-band__list">
        {
          principles.map((p, i) => (
            <li>
              <span class="ab-band__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- how we support you ---------- -->
  <section class="ab-support">
    <div class="wrap">
      <h2>How we support you</h2>
      <ul class="ab-support__list">
        {
          support.map((s) => (
            <li>
              <a href={s.href}>
                <span class="ab-support__title">
                  {s.title} <Fragment set:html={arrow} />
                </span>
                <span class="ab-support__text">{s.text}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="ab-software">
        <div>
          <h2>Our software, your choice</h2>
          <p>
            Waterna RO Insight™ is available separately from our consultancy services. Its use is
            optional and is not a condition of receiving engineering advice.
          </p>
        </div>
        <a class="ab-software__link" href="/ro-insight">Explore RO Insight™ <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- ---------- call to action ---------- -->
  <section class="ab-cta">
    <div class="wrap ab-cta__grid">
      <div>
        <h2>Let’s discuss your water treatment challenge</h2>
        <p>Tell us about your plant, project or operating concern.</p>
      </div>
      <div class="ab-cta__actions">
        <a class="btn btn--primary ab-btn" href="/contact">Contact Waterna <Fragment set:html={arrow} /></a>
        <span class="ab-cta__rule" aria-hidden="true"></span>
        <a class="ab-cta__phone" href={site.phoneHref}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
          {site.phone}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 {
    color: var(--brand-deep);
    font-weight: 800;
  }

  @media (min-width: 560px) {
    .ab-line {
      display: block;
    }
  }

  .ab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ab-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ab-btn:hover :global(svg) {
    transform: translateX(3px);
  }

  /* ---------- hero: the same contained split as the service pages ---------- */

  /* Layer 1: the photograph fills the band. */
  .ab-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  /* Set in from the left so the clarifiers sit clear of the text. */
  .ab-hero__photo img {
    position: absolute;
    inset: 0 0 0 auto;
    width: 72%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 60%;
    z-index: -2;
  }

  /* Layer 2: a pale wash from the left, strong behind the text and clear
     over the clarifiers. */
  .ab-hero__fade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgba(244, 248, 252, 1) 0%,
      rgba(244, 248, 252, 1) 28%,
      rgba(244, 248, 252, 0.85) 40%,
      rgba(244, 248, 252, 0.35) 52%,
      rgba(244, 248, 252, 0) 62%
    );
  }

  /* Layer 3: live text. */
  .ab-hero__text {
    position: relative;
  }

  .ab-hero h1 {
    color: var(--brand-deep);
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1.1rem;
  }

  .ab-hero__lede {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--ink);
    max-width: 44ch;
    margin-bottom: 1.8rem;
  }

  .ab-hero__full {
    display: none;
  }

  /* Desktop: the same height as the other banners, filled by the supplied
     image. Its text sits at 28-84% of the height, so the crop is centred on
     56% to keep the button in view. The live text is kept but visually
     hidden, apart from its button, which sits over the one in the image. */
  @media (min-width: 900px) {
    .ab-hero {
      height: var(--banner-h);
      padding: 0;
    }

    .ab-hero__full {
      display: block;
    }

    .ab-hero__full img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left 56%;
    }

    .ab-hero__photo,
    .ab-hero__fade {
      display: none;
    }

    .ab-hero__text > :not(.ab-btn) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* The live link sits invisibly over the button drawn in the image.
       --s is the rendered size of one source pixel under object-fit:
       cover; the button occupies x 166-478, y 541-611 of the 2172x724
       source. */
    .ab-hero {
      container-type: inline-size;
    }

    .ab-hero__text {
      position: static;
    }

    .ab-hero__text .ab-btn {
      --s: max(100cqw / 2172, var(--banner-h) / 724);
      position: absolute;
      left: calc(var(--s) * 166);
      top: calc((var(--banner-h) - var(--s) * 724) * 0.56 + var(--s) * 541);
      width: calc(var(--s) * 312);
      height: calc(var(--s) * 70);
      padding: 0;
      background: transparent;
      color: transparent;
      overflow: hidden;
    }

    .ab-hero__text .ab-btn :global(svg) {
      display: none;
    }

    .ab-hero__text .ab-btn:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }
  }

  /* Narrow screens: the text spans the width, so the wash covers it all. */
  @media (max-width: 899px) {
    .ab-hero__photo img {
      width: 100%;
    }

    .ab-hero__fade {
      background: linear-gradient(180deg, rgba(244, 248, 252, 0.94), rgba(244, 248, 252, 0.86));
    }
  }

  /* ---------- facts strip ---------- */

  .ab-facts {
    border-block: 1px solid var(--line);
  }

  .ab-facts ul {
    list-style: none;
    margin-block: 0;
    padding: 1.2rem 0;
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 820px) {
    .ab-facts ul {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      gap: 0;
    }

    .ab-facts li + li {
      border-left: 1px solid var(--line);
      padding-left: 2.5rem;
    }

    .ab-facts li {
      padding-right: 2.5rem;
    }

    .ab-facts li:last-child {
      padding-right: 0;
    }
  }

  .ab-facts li {
    margin: 0;
    font-weight: 700;
    color: var(--brand-deep);
  }

  /* ---------- experience + glance ---------- */

  .ab-intro {
    padding-block: clamp(2.75rem, 5vw, 3.75rem);
  }

  .ab-intro__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .ab-intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: 4rem;
    }
  }

  .ab-intro h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    margin-bottom: 1rem;
  }

  .ab-intro p {
    max-width: 50ch;
  }

  .ab-glance {
    background: #eef5fb;
    border: 1px solid #dde9f4;
    border-radius: 4px;
    padding: 1.6rem 1.8rem;
  }

  .ab-glance h2 {
    font-size: 1.4rem;
    margin-bottom: 0.8rem;
  }

  .ab-glance dl {
    margin: 0;
  }

  .ab-glance dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid #d3e3f1;
  }

  .ab-glance dl > div:last-child {
    border-bottom: 0;
  }

  .ab-glance dt {
    color: var(--muted);
  }

  .ab-glance dd {
    margin: 0;
    color: var(--ink);
  }

  /* ---------- principles band ---------- */

  .ab-band {
    position: relative;
    overflow: hidden;
    background: var(--brand-deep);
    color: #d6e6f5;
    padding-block: clamp(2.75rem, 5vw, 3.75rem);
  }

  .ab-band__waves {
    position: absolute;
    top: 0;
    right: 0;
    width: min(40%, 520px);
    height: 55%;
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    opacity: 0.25;
    pointer-events: none;
  }

  .ab-band__inner {
    position: relative;
  }

  .ab-band h2 {
    color: #fff;
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    margin-bottom: 0.5rem;
  }

  .ab-band p.ab-band__lede {
    font-size: 1.1rem;
    margin-bottom: 1.8rem;
  }

  .ab-band__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  @media (min-width: 820px) {
    .ab-band__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .ab-band__list li {
      padding-inline: 2rem;
    }

    .ab-band__list li:first-child {
      padding-left: 0;
    }

    .ab-band__list li + li {
      border-left: 1px solid rgba(255, 255, 255, 0.3);
    }
  }

  .ab-band__list li {
    margin: 0;
  }

  /* Cyan holds 4.7:1 on navy. */
  .ab-band__num {
    display: block;
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .ab-band h3 {
    color: #fff;
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .ab-band p {
    margin: 0;
  }

  /* ---------- how we support you ---------- */

  .ab-support {
    padding-block: clamp(2.75rem, 5vw, 3.75rem) clamp(1.5rem, 3vw, 2rem);
  }

  .ab-support > .wrap > h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    margin-bottom: 1.4rem;
  }

  .ab-support__list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 820px) {
    .ab-support__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ab-support__list li {
    margin: 0;
  }

  .ab-support__list a {
    display: block;
    height: 100%;
    background: #fff;
    border: 1px solid #dfe8f1;
    border-radius: 4px;
    padding: 1.4rem 1.5rem 1.5rem;
    text-decoration: none;
    color: var(--body);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ab-support__list a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -16px rgba(0, 63, 118, 0.35);
  }

  .ab-support__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--brand-deep);
    font-weight: 700;
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .ab-support__title :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    color: #1a9fe0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ab-support__list a:hover .ab-support__title :global(svg) {
    transform: translateX(3px);
  }

  .ab-support__text {
    display: block;
    font-size: 0.98rem;
  }

  .ab-software {
    display: grid;
    gap: 1rem;
    align-items: center;
    background: #eef5fb;
    border-radius: 4px;
    padding: 1.6rem 1.8rem;
  }

  @media (min-width: 820px) {
    .ab-software {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .ab-software h2 {
    font-size: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .ab-software p {
    margin: 0;
    max-width: 62ch;
  }

  .ab-software__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid #1a9fe0;
  }

  .ab-software__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: #1a9fe0;
  }

  /* ---------- call to action ---------- */

  .ab-cta {
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(2.75rem, 5vw, 3.5rem);
  }

  .ab-cta__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ab-cta__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .ab-cta h2 {
    font-size: clamp(1.4rem, 2.1vw, 1.75rem);
    margin-bottom: 0.3rem;
  }

  .ab-cta p {
    margin: 0;
  }

  .ab-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .ab-cta__rule {
    width: 1px;
    height: 2.4rem;
    background: var(--line);
  }

  .ab-cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--brand-deep);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }

  .ab-cta__phone:hover {
    text-decoration: underline;
  }

  .ab-cta__phone svg {
    width: 1.3rem;
    height: 1.3rem;
  }
</style>
