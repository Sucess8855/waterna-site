---
import Base from '../../layouts/Base.astro';
import PillarLanding from '../../components/PillarLanding.astro';
import { projectEngineering } from '../../data/services';
import { pillarBySlug } from '../../data/pillars';
import { serviceIcons as icons } from '../../data/icons';

const pillar = pillarBySlug('project-engineering')!;

const helpWith = [
  'Developing a new treatment scheme',
  'Planning a plant upgrade',
  'Comparing supplier proposals',
  'Preparing for tender or design review',
];

/** One-line descriptions for the service list on this page. */
const lines: Record<string, string> = {
  'feasibility-studies': 'Compare treatment options, technical feasibility and whole-life costs.',
  'design-services':
    'Develop the design basis, calculations, equipment specifications and process drawings.',
  'technical-procurement-support':
    'Prepare tender packages, evaluate bids and resolve technical clarifications.',
  'independent-review': 'Assess design assumptions, process sizing, operability and technical risks.',
  hazop: 'Identify hazards and operability issues through structured, independently chaired reviews.',
};

---

<Base title={pillar.metaTitle} description={pillar.metaDescription}>
  <PillarLanding
    eyebrow="New plants & system upgrades"
    title="Project Engineering"
    sub={['A sound basis for your next project.']}
    lede="Independent engineering support for water and wastewater treatment — from feasibility and process design to procurement and risk review."
    heroCta="Discuss your project"
    banner="pe-banner"
    introTitle="Clear decisions before capital is committed"
    intro={[
      'We assess treatment options, define process requirements and review designs to support reliable operation, maintainability and whole-life value.',
      'Our advice is independent of equipment suppliers and based on your project requirements.',
    ]}
    helpWith={helpWith}
    servicesTitle="Project engineering services"
    services={projectEngineering}
    lines={lines}
    icons={icons}
    ctaTitle="Discuss your treatment project"
    ctaText="Tell us your requirements, constraints and current stage. We will help define the next step."
  />
</Base>
