---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { projectEngineering, hasPage, serviceHref } from '../../data/services';
import { pillarBySlug } from '../../data/pillars';

const pillar = pillarBySlug('project-engineering')!;

const helpWith = [
  'Developing a new treatment scheme',
  'Planning a plant upgrade',
  'Comparing supplier proposals',
  'Preparing for tender or design review',
];

/** One-line descriptions for the service list on this page. */
const lines: Record<string, string> = {
  'feasibility-studies': 'Compare treatment options, technical feasibility and whole-life costs.',
  'design-services':
    'Develop the design basis, calculations, equipment specifications and process drawings.',
  'technical-procurement-support':
    'Prepare tender packages, evaluate bids and resolve technical clarifications.',
  'independent-review': 'Assess design assumptions, process sizing, operability and technical risks.',
  hazop: 'Identify hazards and operability issues through structured, independently chaired reviews.',
};

const icons: Record<string, string> = {
  'feasibility-studies':
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h5"/><path d="M14 2v6h6"/><path d="M20 8v3"/><path d="M8 9h2M8 13h4M8 17h1"/><circle cx="17" cy="17" r="3"/><path d="m21 21-1.8-1.8"/>',
  'design-services':
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  'technical-procurement-support':
    '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3"/><path d="M8.5 10h7M8.5 14h7M8.5 18h4"/>',
  'independent-review':
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m7 15 3.5-3.5 2.5 2.5L17 9"/>',
  hazop:
    '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
};
---

<Base title={pillar.metaTitle} description={pillar.metaDescription}>
  <section class="pe-hero">
    <div class="wrap pe-hero__grid">
    <div class="pe-hero__copy">
      <p class="eyebrow">New plants &amp; system upgrades</p>
      <h1>Project Engineering</h1>
      <p class="pe-hero__sub">A sound basis for your next project.</p>
      <p class="pe-hero__lede">
        Independent engineering support for water, wastewater and sludge treatment — from feasibility
        and process design to procurement and risk review.
      </p>
      <a class="btn btn--primary btn--arrow" href="/contact">
        Discuss your project
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
    <picture class="pe-hero__media">
      <source
        type="image/webp"
        srcset="/img/pillars/pe-hero-800.webp 800w, /img/pillars/pe-hero-1400.webp 1400w"
        sizes="(min-width: 960px) 45vw, 100vw"
      />
      <img
        src="/img/pillars/pe-hero-1400.jpg"
        alt="Two engineers reviewing process drawings at a desk overlooking a treatment works"
        width="1400"
        height="1050"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    </div>
  </section>

  <section class="pe-intro">
    <div class="wrap pe-intro__grid">
      <div>
        <h2>Clear decisions before capital is committed</h2>
        <p>
          We assess treatment options, define process requirements and review designs to support
          reliable operation, maintainability and whole-life value.
        </p>
        <p>Our advice is independent of equipment suppliers and based on your project requirements.</p>
      </div>
      <aside class="pe-help">
        <h3>When we can help</h3>
        <ul>
          {
            helpWith.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" />
                  <path d="m7.5 12.5 3 3 6-6.5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="pe-services">
    <div class="wrap">
      <h2>Project engineering services</h2>
      <ul class="pe-list">
        {
          projectEngineering.map((s) => (
            <li>
              {hasPage(s) ? (
                <a class="pe-list__row pe-list__row--link" href={serviceHref(s)}>
                  <svg class="pe-list__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.slug] ?? ''} />
                  <span class="pe-list__text">
                    <span class="pe-list__title">{s.title}</span>
                    <span class="pe-list__desc">{lines[s.slug] ?? s.summary}</span>
                  </span>
                  <svg class="pe-list__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              ) : (
                <div class="pe-list__row">
                  <svg class="pe-list__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.slug] ?? ''} />
                  <span class="pe-list__text">
                    <span class="pe-list__title">{s.title}</span>
                    <span class="pe-list__desc">{lines[s.slug] ?? s.summary}</span>
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pe-cta">
    <div class="wrap">
      <h2>Discuss your treatment project</h2>
      <p>Tell us your requirements, constraints and current stage. We will help define the next step.</p>
      <div class="pe-cta__actions">
        <a class="btn btn--light btn--arrow" href="/contact">
          Contact us
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <span class="pe-cta__rule" aria-hidden="true"></span>
        <a class="pe-cta__phone" href={site.phoneHref}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
          {site.phone}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */

  /* Same contained split as the sector pages, so the photo keeps a fixed
     shape instead of growing with the window. */
  .pe-hero {
    background: #eaf2fa;
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .pe-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .pe-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .pe-hero h1 {
    color: var(--brand-deep);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .pe-hero__sub {
    color: var(--brand-deep);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .pe-hero__lede {
    font-size: 1.1rem;
    max-width: 44ch;
    margin-bottom: 1.8rem;
  }

  .pe-hero__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: var(--shadow-card);
  }

  .btn--arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn--arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn--arrow:hover svg {
    transform: translateX(3px);
  }

  /* ---------- intro ---------- */

  .pe-intro {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pe-intro__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .pe-intro__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }

  .pe-intro h2 {
    color: var(--brand-deep);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    max-width: 18ch;
    margin-bottom: 1.2rem;
  }

  .pe-intro p {
    max-width: 52ch;
  }

  .pe-help {
    background: #eaf2fa;
    border-radius: 4px;
    padding: 2rem 2.2rem;
  }

  .pe-help h3 {
    color: var(--brand-deep);
    font-size: 1.4rem;
    margin-bottom: 1.1rem;
  }

  .pe-help ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pe-help li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.9rem;
    color: var(--ink);
  }

  .pe-help li:last-child {
    margin-bottom: 0;
  }

  .pe-help svg {
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
  }

  .pe-help svg circle {
    fill: #1a9fe0;
  }

  .pe-help svg path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- services ---------- */

  .pe-services {
    background: #eaf2fa;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pe-services h2 {
    color: var(--brand-deep);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 1.6rem;
  }

  .pe-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .pe-list li {
    margin: 0;
  }

  .pe-list__row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.6rem;
    background: #fff;
    border: 1px solid #dfe8f1;
    border-radius: 4px;
    padding: 1.25rem 1.6rem;
    text-decoration: none;
    color: inherit;
  }

  .pe-list__row--link {
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pe-list__row--link:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -16px rgba(0, 63, 118, 0.35);
  }

  .pe-list__icon {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--brand-deep);
  }

  .pe-list__text {
    display: block;
  }

  .pe-list__title {
    display: block;
    color: var(--brand-deep);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 0.15rem;
  }

  .pe-list__desc {
    display: block;
    color: var(--body);
    font-size: 0.98rem;
  }

  .pe-list__arrow {
    width: 1.5rem;
    height: 1.5rem;
    color: #1a9fe0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pe-list__row--link:hover .pe-list__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 560px) {
    .pe-list__row {
      grid-template-columns: 2.2rem minmax(0, 1fr) auto;
      gap: 1rem;
      padding: 1rem 1.1rem;
    }

    .pe-list__icon {
      width: 2.1rem;
      height: 2.1rem;
    }
  }

  /* ---------- cta ---------- */

  .pe-cta {
    background: var(--brand-deep);
    color: rgba(255, 255, 255, 0.9);
    padding-block: clamp(2.5rem, 5vw, 3.25rem);
  }

  .pe-cta h2 {
    color: #fff;
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 800;
    margin-bottom: 0.6rem;
  }

  .pe-cta p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .pe-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .pe-cta__rule {
    width: 1px;
    height: 2.4rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .pe-cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pe-cta__phone:hover {
    text-decoration: underline;
  }

  .pe-cta__phone svg {
    width: 1.4rem;
    height: 1.4rem;
  }
</style>
