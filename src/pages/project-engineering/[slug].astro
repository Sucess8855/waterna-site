---
import Base from '../../layouts/Base.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import ServicePage from '../../components/ServicePage.astro';
import { projectEngineering, hasPage } from '../../data/services';

export function getStaticPaths() {
  return projectEngineering.filter(hasPage).map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Base title={service.metaTitle} description={service.metaDescription}>
  {service.page ? <ServicePage service={service} /> : <ServiceDetail service={service} />}
</Base>
