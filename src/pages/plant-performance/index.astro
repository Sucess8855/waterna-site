---
import Base from '../../layouts/Base.astro';
import PillarLanding from '../../components/PillarLanding.astro';
import { plantPerformance, roInsight, serviceHref } from '../../data/services';
import { pillarBySlug } from '../../data/pillars';

const pillar = pillarBySlug('plant-performance')!;

const helpWith = [
  'Treatment quality or output is declining',
  'Energy or chemical use is increasing',
  'Membranes need frequent cleaning',
  'A new or upgraded plant needs testing',
];

/** One-line descriptions for the service list on this page. */
const lines: Record<string, string> = {
  'plant-optimisation':
    'Investigate process constraints and prioritise practical operational improvements.',
  'uf-ro-performance-assessment':
    'Assess membrane condition, pretreatment, cleaning performance and energy use.',
  'chemical-dosing-cip':
    'Review chemical selection, dosing and cleaning procedures for the treatment duty.',
  'commissioning-performance-testing':
    'Assess plant performance against agreed criteria and test conditions.',
  'data-analysis': 'Turn operating records into trends, engineering findings and clear actions.',
};

const icons: Record<string, string> = {
  'plant-optimisation':
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  // Stacked membrane elements.
  'uf-ro-performance-assessment':
    '<rect x="3" y="4" width="18" height="4" rx="2"/><rect x="3" y="10" width="18" height="4" rx="2"/><rect x="3" y="16" width="18" height="4" rx="2"/><path d="M7 6h10M7 12h10M7 18h10"/>',
  'chemical-dosing-cip':
    '<path d="M10 2v7.31"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/>',
  'commissioning-performance-testing':
    '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3"/><path d="M8.5 10h7M8.5 14h7M8.5 18h4"/>',
  'data-analysis':
    '<path d="M4 20h16"/><rect x="5" y="13" width="3" height="7"/><rect x="10.5" y="8" width="3" height="12"/><rect x="16" y="3" width="3" height="17"/>',
};

const roRow = {
  title: 'Ongoing insight for RO plants',
  desc: 'Complement an engineering assessment with Waterna RO Insight™.',
  href: serviceHref(roInsight),
  label: 'Explore RO Insight™',
  icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="m6 13 3.5-3.5 2.5 2.5L18 7"/><path d="M15 7h3v3"/>',
};
---

<Base title={pillar.metaTitle} description={pillar.metaDescription}>
  <PillarLanding
    eyebrow="Commissioning, troubleshooting & optimisation"
    title="Plant Performance"
    sub={['Understand the cause.', 'Improve the performance.']}
    lede="Practical engineering support for water, wastewater and sludge treatment, including UF and RO systems. We help identify performance constraints, improve operation and assess results."
    heroCta="Discuss your plant"
    image={{ base: 'pp-hero', alt: 'Two Waterna engineers reviewing plant data on a tablet beside a clarifier' }}
    introTitle="Engineering insight for better operation"
    intro={[
      'We combine operating data, process calculations and site observations to investigate performance issues and prioritise practical improvements.',
      'Where records are incomplete, we identify the measurements needed to support a reliable assessment.',
    ]}
    helpWith={helpWith}
    servicesTitle="Plant performance services"
    services={plantPerformance}
    lines={lines}
    icons={icons}
    extra={roRow}
    ctaTitle="Let’s discuss your plant’s performance"
    ctaText="Tell us what has changed and what you need to achieve. We will help identify a practical next step."
  />
</Base>
