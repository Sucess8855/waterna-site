---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { pillars, softwarePillar } from '../../data/pillars';
import { projectEngineering, plantPerformance, softwareProducts, serviceHref } from '../../data/services';

const counts: Record<string, number> = {
  'project-engineering': projectEngineering.length,
  'plant-performance': plantPerformance.length,
};

const forks = [...pillars, softwarePillar];

const members: Record<string, typeof projectEngineering> = {
  'project-engineering': projectEngineering,
  'plant-performance': plantPerformance,
  software: softwareProducts,
};
---

<Base
  title="What We Do | Waterna Water Treatment Consultants"
  description="Project engineering for schemes that do not exist yet, and plant performance work for those that do — plus Waterna RO Insight, our desalination software platform."
>
  <section class="phead">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h1>What we <span class="hl">do</span></h1>
      <p class="lede">
        Engineering for plant that does not exist yet, performance work for plant that does, and
        software where a method is worth running continuously.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="fork">
        {
          forks.map((p) => (
            <article class="fork__card card--lift">
              <p class="fork__strap">{p.strapline}</p>
              <h2>
                <a href={`/${p.slug}`}>{p.title}</a>
              </h2>
              <p class="fork__summary">{p.summary}</p>
              <ul class="fork__list">
                {members[p.slug].map((s) => (
                  <li>
                    <a href={serviceHref(s)}>{s.navTitle ?? s.title}</a>
                  </li>
                ))}
              </ul>
              <a class="btn btn--ghost" href={`/${p.slug}`}>
                {p.title} &rarr;
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <div>
        <h2>Not sure which you need?</h2>
        <p>
          Most people are not, at the start. Describe the problem and we will tell you what the
          right first step is.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={site.phoneHref}>{site.phone}</a>
        <a class="btn btn--ghost" href="/contact">Contact page</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .phead {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .fork {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .fork {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .fork__card {
    border: 1px solid var(--line);
    border-top: 3px solid var(--ember);
    border-radius: 4px;
    padding: 2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .fork__strap {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  .fork__card h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 0.6rem;
  }

  .fork__card h2 a {
    text-decoration: none;
    color: var(--ink);
  }

  .fork__card h2 a:hover {
    color: var(--brand);
  }

  .fork__summary {
    max-width: 46ch;
  }

  .fork__list {
    list-style: none;
    margin: 0.5rem 0 1.75rem;
    padding: 0;
    border-top: 1px solid var(--line);
    flex: 1;
  }

  .fork__list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .fork__list a {
    display: block;
    padding: 0.65rem 0;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
  }

  .fork__list a:hover {
    text-decoration: underline;
  }

  .fork__card .btn {
    align-self: flex-start;
  }

  .product {
    background: var(--brand-deep);
    color: rgba(255, 255, 255, 0.86);
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  .product :global(h2) {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .product__eyebrow {
    color: var(--accent);
  }

  .product__lede {
    font-size: 1.05rem;
    max-width: 52ch;
    margin-bottom: 1.6rem;
  }

  .cta {
    background: var(--brand-tint);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .cta__inner {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .cta h2 {
    margin-bottom: 0.4rem;
  }

  .cta p {
    margin-bottom: 0;
    max-width: 54ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
