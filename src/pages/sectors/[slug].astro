---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { sectors } from '../../data/sectors';
import { services } from '../../data/services';

export function getStaticPaths() {
  return sectors.map((sector) => ({
    params: { slug: sector.slug },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const related = sector.relatedServices
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);
---

<Base title={sector.metaTitle} description={sector.metaDescription}>
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/sectors">Sectors</a> <span aria-hidden="true">&rsaquo;</span>
        <span>{sector.navTitle ?? sector.title}</span>
      </nav>
      <h1>{sector.title}</h1>
      <p class="lede">{sector.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div class="cols__main">
        <h2>How we work in this sector</h2>
        {sector.body.map((para) => <p>{para}</p>)}

        <h2>What usually goes wrong</h2>
        <dl class="deflist">
          {
            sector.challenges.map(([term, def]) => (
              <div>
                <dt>{term}</dt>
                <dd>{def}</dd>
              </div>
            ))
          }
        </dl>

        <h2>Processes we work with</h2>
        <ul class="tech">
          {sector.technologies.map((t) => <li>{t}</li>)}
        </ul>
        <p class="tech__note">
          We specify no equipment of our own, so this list reflects what the process may need — not a
          product range we are trying to sell.
        </p>
      </div>

      <aside class="cols__side">
        <div class="panel">
          <h2 class="panel__h">Talk it through</h2>
          <p>
            Tell us the water, the flow and the consent you are working to, and we will tell you
            whether there is a project here.
          </p>
          <p class="panel__contact">
            <a class="btn btn--primary" href={site.phoneHref}>Call {site.phone}</a>
          </p>
          <p class="panel__small">
            Or email <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <div class="panel panel--plain">
          <h2 class="panel__h">Relevant services</h2>
          <ul>
            {
              related.map((r) => (
                <li>
                  <a href={`/services/${r!.slug}`}>{r!.navTitle ?? r!.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .phead {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .crumbs a {
    color: var(--brand);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .crumbs span[aria-hidden] {
    margin-inline: 0.35rem;
  }

  .cols {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 3.5rem;
      align-items: start;
    }

    .cols__side {
      position: sticky;
      top: 6rem;
    }
  }

  .cols__main h2 {
    margin-top: 2.25rem;
  }

  .cols__main h2:first-child {
    margin-top: 0;
  }

  .cols__main p {
    max-width: 68ch;
  }

  .deflist {
    margin: 0 0 1.5rem;
  }

  .deflist > div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .deflist dt {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }

  .deflist dd {
    margin: 0;
    font-size: 0.98rem;
    max-width: 68ch;
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
  }

  .tech li {
    font-size: 0.9rem;
    color: var(--body);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.35rem 0.7rem;
    margin: 0;
  }

  .tech__note {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .panel {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .panel--plain {
    background: #fff;
  }

  .panel__h {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .panel p {
    font-size: 0.95rem;
  }

  .panel__contact {
    margin-bottom: 0.6rem;
  }

  .panel__small {
    margin-bottom: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .panel li {
    margin-bottom: 0.4rem;
  }

  .panel li a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .panel li a:hover {
    text-decoration: underline;
  }
</style>
