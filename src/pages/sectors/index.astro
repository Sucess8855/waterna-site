---
import Base from '../../layouts/Base.astro';
import { sectors } from '../../data/sectors';

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';

---

<Base
  title="Sectors We Work In | Waterna"
  description="Process engineering for UF and RO desalination, industrial water, wastewater and oil and gas produced water treatment — new systems and the improvement of existing plant."
>
  <section class="sx-hero">
    <picture class="sx-hero__water" aria-hidden="true">
      <source type="image/webp" srcset="/img/sectors/banner-desal-1200.webp" />
      <img src="/img/sectors/banner-desal-1200.jpg" alt="" width="1200" height="701" fetchpriority="high" />
    </picture>
    <div class="wrap sx-hero__inner">
      <p class="eyebrow">Where we work</p>
      <h1>Sectors we work in</h1>
      <p class="sx-hero__lede">
        Process engineering for desalination, industrial water, wastewater and produced water
        treatment.
      </p>
      <p class="sx-hero__lede">
        Supporting new projects and existing plants, with particular expertise in ultrafiltration and
        reverse osmosis.
      </p>
    </div>
  </section>

  <section class="sx-list">
    <div class="wrap sx-grid">
      {
        sectors.map((s) => (
          <article class="sx-card">
            <a class="sx-card__media" href={`/sectors/${s.slug}`} tabindex="-1" aria-hidden="true">
              <picture>
                <source
                  type="image/webp"
                  srcset={`/img/sectors/${s.image}-600.webp 600w, /img/sectors/${s.image}-1200.webp 1200w`}
                  sizes="(min-width: 760px) 45vw, 100vw"
                />
                <img
                  src={`/img/sectors/${s.image}-1200.jpg`}
                  alt=""
                  width="1200"
                  height="674"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </a>
            <div class="sx-card__body">
              <h2>
                <a href={`/sectors/${s.slug}`}>{s.navTitle ?? s.title}</a>
              </h2>
              <p>{s.card.text}</p>
              <ul>
                {s.card.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <a class="sx-card__more" href={`/sectors/${s.slug}`} aria-hidden="true" tabindex="-1">
                Explore {s.navTitle ?? s.title} <Fragment set:html={arrow} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="sx-cta">
    <div class="wrap sx-cta__grid">
      <div>
        <h2>More than one treatment challenge?</h2>
        <p>We help you assess how your water supply, treatment and reuse systems work together.</p>
      </div>
      <a class="btn btn--light sx-btn" href="/contact">Discuss your project <Fragment set:html={arrow} /></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- header band ---------- */

  /* Pale ground with a coastal desalination plant fading in from the right. */
  .sx-hero {
    position: relative;
    overflow: hidden;
    background: #f2f6fc;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  @media (min-width: 900px) {
    .sx-hero {
      min-height: var(--banner-h);
      display: flex;
      align-items: center;
      padding-block: 2.5rem;
    }

    .sx-hero > .wrap {
      width: min(100% - 2.5rem, var(--wrap));
    }
  }

  .sx-hero__water img {
    position: absolute;
    top: 0;
    right: 0;
    width: min(58%, 900px);
    height: 100%;
    object-fit: cover;
    object-position: left center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
    pointer-events: none;
  }

  .sx-hero__inner {
    position: relative;
  }

  .sx-hero h1 {
    color: var(--brand-deep);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 1.1rem;
  }

  .sx-hero__lede {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--ink);
    max-width: 44ch;
    margin: 0 0 0.9rem;
  }

  .sx-hero__lede:last-child {
    margin-bottom: 0;
  }

  /* On narrow screens the text runs full width, so the water steps back. */
  @media (max-width: 759px) {
    .sx-hero__water img {
      width: 100%;
      opacity: 0.35;
    }
  }

  /* ---------- cards ---------- */

  .sx-list {
    padding-block: clamp(2rem, 4vw, 2.75rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .sx-grid {
    display: grid;
    gap: 1.2rem;
  }

  @media (min-width: 760px) {
    .sx-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sx-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #dfe8f1;
    border-radius: 6px;
    padding: 0.8rem 0.8rem 1.4rem;
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sx-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px -18px rgba(0, 63, 118, 0.32);
  }

  .sx-card__media img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: 3px;
  }

  .sx-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 0.4rem 0;
  }

  .sx-card h2 {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .sx-card h2 a {
    color: var(--brand-deep);
    text-decoration: none;
  }

  /* The whole card is the link target. */
  .sx-card h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .sx-card h2 a:focus-visible {
    outline: none;
  }

  .sx-card:has(h2 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sx-card p {
    margin-bottom: 0.9rem;
  }

  .sx-card ul {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
  }

  .sx-card li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.3rem;
    color: var(--ink);
    font-size: 0.98rem;
  }

  .sx-card li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #1a9fe0;
  }

  .sx-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--brand-deep);
    text-decoration: none;
  }

  .sx-card__more :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sx-card:hover .sx-card__more :global(svg) {
    transform: translateX(3px);
  }

  /* ---------- call to action ---------- */

  .sx-cta {
    background: var(--brand-deep);
    color: #d6e6f5;
    padding-block: clamp(2rem, 4vw, 2.75rem);
  }

  .sx-cta__grid {
    display: grid;
    gap: 1.4rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .sx-cta__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .sx-cta h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    margin-bottom: 0.3rem;
  }

  .sx-cta p {
    margin: 0;
    font-size: 1.05rem;
  }

  .sx-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sx-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
